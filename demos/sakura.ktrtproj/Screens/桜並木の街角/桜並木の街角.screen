screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables:
  - id: "drift"
    kind: "normal"
    name: "$drift"
    value_type: "Float"
    initial_value: "6"
requests: []
space:
  entities:
    - id: "camera"
      name: "Camera"
      type: "camera"
      position:
        x: 0
        y: 1.35
        z: 0
      rotation:
        x: 3.3
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      projection: "perspective"
      fov: 55
      fov_axis: "horizontal"
      near_clip: 0.05
      far_clip: 400
      clear_color: "#8fbde4"
      tonemapping: "neutral"
      gamma: "srgb"
      output: "buffer"
      post_effects:
        - id: "fx_ssao"
          type: "ssao"
          radius: 0.4
          intensity: 0.15
          bias: 0.03
          samples: 16
        - id: "fx_fog"
          type: "depth_fog"
          color: "#aebbcb"
          fog_start: 85
          fog_end: 330
          power: 1.7
          sky_amount: 0
        - id: "fx_bloom"
          type: "bloom"
          threshold: 0.72
          strength: 0.44
          radius: 14
        - id: "fx_grade"
          type: "color_balance"
          color: "#8a8eb2"
          color2: "#868686"
          color3: "#8c867c"
          amount: 0.44
        - id: "fx_vig"
          type: "vignette"
          x: 0.5
          y: 0.52
          radius: 0.94
          strength: 0.08
        - id: "fx_fxaa"
          type: "fxaa"
    - id: "sun"
      name: "Sun"
      type: "light"
      position:
        x: 0
        y: 12
        z: 0
      rotation:
        x: 52
        y: 150
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      light_type: "directional"
      color: "#fff3dc"
      intensity: 4.4
      cast_shadows: true
      shadow_resolution: 4096
      shadow_type: "pcf5"
      shadow_distance: 60
      shadow_bias: 0.04
    - id: "fill"
      name: "Sky Fill"
      type: "light"
      position:
        x: 0
        y: 12
        z: 0
      rotation:
        x: 30
        y: -12
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      light_type: "directional"
      color: "#9ab4ea"
      intensity: 1.75
      cast_shadows: false
    - id: "bounce"
      name: "Ground Bounce"
      type: "light"
      position:
        x: 0
        y: 12
        z: 0
      rotation:
        x: -55
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      light_type: "directional"
      color: "#ecdcc8"
      intensity: 0.78
      cast_shadows: false
    - id: "g_ground"
