    ambient:
      source: "skybox"
      intensity: 2.05
    skybox:
      source: "gradient"
      sky_color: "#1f74c6"
      horizon_color: "#c4dff4"
      ground_color: "#7c828d"
      horizon_falloff: 5.5
      intensity: 1
      show_background: true
    fog:
      type: "linear"
      color: "#b4c2d2"
      start: 110
      end: 420
    tone:
      tonemapping: "neutral"
      exposure: 0.87
      gamma: "srgb"
  sequences:
    - id: "petal_fall"
      name: "Petal Fall"
      kind: "state_loop"
      duration: 9
      tracks:
        - id: "drift-track"
          kind: "variable"
          variable_id: "drift"
          time_offset: 0
          keyframes:
            - time: 0
              value: "6"
              easing: "linear"
            - time: 9
              value: "-0.2"
              easing: "linear"
