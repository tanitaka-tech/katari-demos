schema_version: 2
kind: "material"
id: "mat_petal"
name: "Petal"
parent_material_id: null
graph:
  nodes:
    -
      id: "material_uv_1"
      type: "material_uv"
      position:
        x: 0
        y: 0
      properties: {}
    -
      id: "shape_ngon_1"
      type: "shape_ngon"
      position:
        x: 260
        y: 0
      properties:
        center: "0.5,0.5"
        radius: 0.42
        sides: 5
        angle: 0
    -
      id: "sdf_round_1"
      type: "sdf_round"
      position:
        x: 520
        y: 0
      properties:
        radius: 0.1
    -
      id: "sdf_fill_1"
      type: "sdf_fill"
      position:
        x: 780
        y: 0
      properties:
        softness: 0.02
    -
      id: "material_output_3d_1"
      type: "material_output_3d"
      position:
        x: 1040
        y: 0
      properties:
        diffuse: "#fbe4ef"
        emissive: "#f6d5e6"
        emissive_intensity: 0.16
        gloss: 0.1
        alpha_test: 0.4
        two_sided: true
  edges:
    -
      id: "material_uv_1:value>shape_ngon_1:uv"
      from:
        nodeId: "material_uv_1"
        pin: "value"
      to:
        nodeId: "shape_ngon_1"
        pin: "uv"
    -
      id: "shape_ngon_1:value>sdf_round_1:d"
      from:
        nodeId: "shape_ngon_1"
        pin: "value"
      to:
        nodeId: "sdf_round_1"
        pin: "d"
    -
      id: "sdf_round_1:return>sdf_fill_1:d"
      from:
        nodeId: "sdf_round_1"
        pin: "return"
      to:
        nodeId: "sdf_fill_1"
        pin: "d"
    -
      id: "sdf_fill_1:return>material_output_3d_1:opacity"
      from:
        nodeId: "sdf_fill_1"
        pin: "return"
      to:
        nodeId: "material_output_3d_1"
        pin: "opacity"
defaults: {}
purpose: "space-3d"
