screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables:
  - id: "turn"
    kind: "normal"
    name: "$turn"
    value_type: "Float"
    initial_value: "0"
requests: []
space:
  entities:
    - id: "camera"
      name: "Camera"
      type: "camera"
      position:
        x: 0
        y: 4.4
        z: 11
      rotation:
        x: -14
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      projection: "perspective"
      fov: 52
      clear_color: "#161b23"
      output: "buffer"
      camera_work:
        look_at:
          target_id: "ground"
          offset:
            x: 0
            y: 0.8
            z: 0
        dolly:
          points:
            - x: 0
              y: 4.4
              z: 11
            - x: 2.847009496127728
              y: 4.4
              z: 10.62518408917975
            - x: 5.499999999999999
              y: 4.4
              z: 9.526279441628827
            - x: 7.778174593052022
              y: 4.4
              z: 7.778174593052023
            - x: 9.526279441628825
              y: 4.4
              z: 5.500000000000001
            - x: 10.62518408917975
              y: 4.4
              z: 2.847009496127728
            - x: 11
              y: 4.4
              z: 6.735557395310443e-16
            - x: 10.62518408917975
              y: 4.4
              z: -2.8470094961277295
            - x: 9.526279441628827
              y: 4.4
              z: -5.499999999999997
            - x: 7.778174593052023
              y: 4.4
              z: -7.778174593052022
            - x: 5.499999999999999
              y: 4.4
              z: -9.526279441628827
            - x: 2.8470094961277312
              y: 4.4
              z: -10.62518408917975
            - x: 1.3471114790620886e-15
              y: 4.4
              z: -11
            - x: -2.8470094961277237
              y: 4.4
              z: -10.625184089179752
            - x: -5.500000000000001
              y: 4.4
              z: -9.526279441628825
            - x: -7.778174593052022
              y: 4.4
              z: -7.778174593052024
            - x: -9.526279441628823
              y: 4.4
              z: -5.500000000000005
            - x: -10.62518408917975
              y: 4.4
              z: -2.847009496127727
            - x: -11
              y: 4.4
              z: -2.0206672185931327e-15
            - x: -10.625184089179752
              y: 4.4
              z: 2.8470094961277232
            - x: -9.526279441628825
              y: 4.4
              z: 5.500000000000001
            - x: -7.778174593052024
              y: 4.4
              z: 7.778174593052021
            - x: -5.500000000000005
              y: 4.4
              z: 9.526279441628823
            - x: -2.8470094961277277
              y: 4.4
              z: 10.62518408917975
          position: "$turn"
          closed: true
    - id: "key"
      name: "Key Light"
      type: "light"
      position:
        x: 0
        y: 8
        z: 0
      rotation:
        x: 52
        y: -34
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      light_type: "directional"
      color: "#e8eeff"
      intensity: 1.25
      cast_shadows: true
      shadow_resolution: 2048
      shadow_type: "pcf3"
      shadow_distance: 48
    - id: "fill"
      name: "Fill Light"
      type: "light"
      position:
        x: 0
        y: 8
        z: 0
      rotation:
        x: 12
        y: 120
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      light_type: "directional"
      color: "#c8d6ff"
      intensity: 0.4
      cast_shadows: false
    - id: "ground"
      name: "床"
      type: "render"
      position:
        x: 0
        y: 0.85
        z: 0
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "box"
      color: "#39424f"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "box"
        width: 12
        height: 0.3
        depth: 12
      physics:
        body: "static"
        layer: "solid"
        collider:
          shape: "box"
          half_extents:
            x: 6
            y: 0.15
            z: 6
    - id: "ramp"
      name: "坂"
      type: "render"
      position:
        x: 3.4
        y: 1.9
        z: -1.2
      rotation:
        x: 0
        y: 18
        z: -26
      scale:
        x: 1
        y: 1
        z: 1
      shape: "box"
      color: "#6f7a88"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "box"
        width: 4.4
        height: 0.24
        depth: 4.4
      physics:
        body: "static"
        layer: "solid"
        collider:
          shape: "box"
          half_extents:
            x: 2.2
            y: 0.12
            z: 2.2
    - id: "step_low"
      name: "段（低）"
      type: "render"
      position:
        x: -1.1
        y: 1.35
        z: -3.4
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "box"
      color: "#7d858f"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "box"
        width: 2.2
        height: 0.7
        depth: 2.2
      physics:
        body: "static"
        layer: "solid"
        collider:
          shape: "box"
          half_extents:
            x: 1.1
            y: 0.35
            z: 1.1
    - id: "step_high"
      name: "段（高）"
      type: "render"
      position:
        x: -3.1
        y: 1.8
        z: -3.4
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "box"
      color: "#8d959f"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "box"
        width: 1.8
        height: 1.6
        depth: 1.8
      physics:
        body: "static"
        layer: "solid"
        collider:
          shape: "box"
          half_extents:
            x: 0.9
            y: 0.8
            z: 0.9
    - id: "dome"
      name: "球"
      type: "render"
      position:
        x: 1.2
        y: 2.1
        z: 3.2
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "sphere"
      color: "#a8b2be"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "sphere"
        radius: 1.1
        segments: 32
      physics:
        body: "static"
        layer: "solid"
        collider:
          shape: "sphere"
          radius: 1.1
    - id: "roof"
      name: "屋根"
      type: "render"
      position:
        x: -3.2
        y: 3.6
        z: 2.4
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "box"
      color: "#5c6675"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "box"
        width: 3.2
        height: 0.16
        depth: 3.2
      physics:
        body: "static"
        layer: "solid"
        collider:
          shape: "box"
          half_extents:
            x: 1.6
            y: 0.08
            z: 1.6
    - id: "roof_post"
      name: "柱"
      type: "render"
      position:
        x: -3.2
        y: 2.3
        z: 2.4
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "cylinder"
      color: "#4c5462"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "cylinder"
        top_radius: 0.09
        bottom_radius: 0.09
        height: 2.6
        segments: 16
    - id: "rain"
      name: "雨"
      type: "particles"
      position:
        x: 0
        y: 5.5
        z: 0
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      effect_id: "builtin:3d-rain-collide"
      seed: 3
      time_scale: 1
      area:
        x: 12
        y: 9
        z: 12
      loop: true
  environment:
    ambient:
      source: "skybox"
      intensity: 0.75
    skybox:
      source: "gradient"
      sky_color: "#2f3b50"
      horizon_color: "#7d8ba1"
      ground_color: "#252a32"
      intensity: 1
      show_background: true
    tone:
      tonemapping: "neutral"
      exposure: 1
      gamma: "srgb"
  sequences:
    - id: "turntable"
      name: "Turntable"
      kind: "state_loop"
      duration: 22
      tracks:
        - id: "turn-track"
          kind: "variable"
          variable_id: "turn"
          time_offset: 0
          keyframes:
            - time: 0
              value: "0"
              easing: "linear"
            - time: 22
              value: "1"
              easing: "linear"
