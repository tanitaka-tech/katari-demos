screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables:
  - id: "turn"
    kind: "normal"
    name: "$turn"
    value_type: "Float"
    initial_value: "0"
requests: []
space:
  entities:
    - id: "camera"
      name: "Camera"
      type: "camera"
      position:
        x: 0
        y: 3.1
        z: 9
      rotation:
        x: -10
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      projection: "perspective"
      fov: 50
      clear_color: "#1a1f28"
      output: "buffer"
      camera_work:
        look_at:
          target_id: "ground"
          offset:
            x: 0
            y: 0.4
            z: 0
        dolly:
          points:
            - x: 0
              y: 3.1
              z: 9
            - x: 2.7811529493745266
              y: 3.1
              z: 8.559508646656381
            - x: 5.2900672706322585
              y: 3.1
              z: 7.281152949374527
            - x: 7.281152949374527
              y: 3.1
              z: 5.2900672706322585
            - x: 8.559508646656381
              y: 3.1
              z: 2.781152949374527
            - x: 9
              y: 3.1
              z: 5.51091059616309e-16
            - x: 8.559508646656383
              y: 3.1
              z: -2.781152949374526
            - x: 7.281152949374527
              y: 3.1
              z: -5.290067270632258
            - x: 5.290067270632259
              y: 3.1
              z: -7.281152949374526
            - x: 2.7811529493745275
              y: 3.1
              z: -8.559508646656381
            - x: 1.102182119232618e-15
              y: 3.1
              z: -9
            - x: -2.7811529493745297
              y: 3.1
              z: -8.559508646656381
            - x: -5.290067270632258
              y: 3.1
              z: -7.281152949374527
            - x: -7.281152949374526
              y: 3.1
              z: -5.290067270632259
            - x: -8.559508646656381
              y: 3.1
              z: -2.781152949374528
            - x: -9
              y: 3.1
              z: -1.6532731788489267e-15
            - x: -8.559508646656383
              y: 3.1
              z: 2.7811529493745253
            - x: -7.281152949374528
              y: 3.1
              z: 5.290067270632257
            - x: -5.29006727063226
              y: 3.1
              z: 7.281152949374526
            - x: -2.7811529493745284
              y: 3.1
              z: 8.559508646656381
          position: "$turn"
          closed: true
    - id: "key"
      name: "Key Light"
      type: "light"
      position:
        x: 0
        y: 6
        z: 0
      rotation:
        x: 55
        y: -30
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      light_type: "directional"
      color: "#e8eeff"
      intensity: 1.3
      cast_shadows: true
      shadow_resolution: 2048
      shadow_type: "pcf3"
      shadow_distance: 40
    - id: "fill"
      name: "Fill Light"
      type: "light"
      position:
        x: 0
        y: 6
        z: 0
      rotation:
        x: 15
        y: 120
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      light_type: "directional"
      color: "#c8d6ff"
      intensity: 0.45
      cast_shadows: false
    - id: "ground"
      name: "床"
      type: "render"
      position:
        x: 0
        y: 0.8999999999999999
        z: 0
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "plane"
      color: "#39424f"
      cast_shadows: false
      receive_shadows: true
      params:
        kind: "plane"
        width: 8
        height: 8
        segments_w: 1
        segments_h: 1
    - id: "post"
      name: "柱"
      type: "render"
      position:
        x: 1.6
        y: 1.7999999999999998
        z: -1.2
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      shape: "cylinder"
      color: "#7d858f"
      cast_shadows: true
      receive_shadows: true
      params:
        kind: "cylinder"
        top_radius: 0.18
        bottom_radius: 0.18
        height: 1.8
        segments: 20
    - id: "rain"
      name: "雨"
      type: "particles"
      position:
        x: 0
        y: 3.4
        z: 0
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 1
        y: 1
        z: 1
      effect_id: "builtin:3d-rain"
      seed: 1
      time_scale: 1
      area:
        x: 8
        y: 5
        z: 8
      loop: true
  environment:
    ambient:
      source: "skybox"
      intensity: 0.8
    skybox:
      source: "gradient"
      sky_color: "#38455c"
      horizon_color: "#8d9bb0"
      ground_color: "#2b3038"
      intensity: 1
      show_background: true
    tone:
      tonemapping: "neutral"
      exposure: 1
      gamma: "srgb"
  sequences:
    - id: "turntable"
      name: "Turntable"
      kind: "state_loop"
      duration: 18
      tracks:
        - id: "turn-track"
          kind: "variable"
          variable_id: "turn"
          time_offset: 0
          keyframes:
            - time: 0
              value: "0"
              easing: "linear"
            - time: 18
              value: "1"
              easing: "linear"
