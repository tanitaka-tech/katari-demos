screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables:
  - kind: "normal"
    id: "screen_title"
    name: "title_screen"
    value_type: "Screen"
    initial_value: "screen_title"
  - kind: "normal"
    id: "screen_dialogue"
    name: "dialogue_screen"
    value_type: "Screen"
    initial_value: "screen_dialogue"
  - kind: "normal"
    id: "screen_backlog"
    name: "backlog_screen"
    value_type: "Screen"
    initial_value: "screen_backlog"
  - kind: "normal"
    id: "screen_settings"
    name: "settings_screen"
    value_type: "Screen"
    initial_value: "screen_settings"
  - kind: "normal"
    id: "screen_save_load"
    name: "save_load_screen"
    value_type: "Screen"
    initial_value: "screen_save_load"
requests: []
script_graph:
  nodes:
    - id: "begin_play"
      type: "event_begin_play"
      next: "open_title_screen"
    - id: "get_title_screen"
      type: "get_variable_screen"
      properties:
        variable: "screen_title"
    - id: "open_title_screen"
      type: "open_screen_call"
  layout:
    - id: "begin_play"
      x: 80
      y: 80
    - id: "get_title_screen"
      x: 360
      y: 160
    - id: "open_title_screen"
      x: 360
      y: 80
  edges:
    - from:
        nodeId: "get_title_screen"
        pin: "value"
      to:
        nodeId: "open_title_screen"
        pin: "screen"
