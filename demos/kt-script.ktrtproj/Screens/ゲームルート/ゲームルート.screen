screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables:
  - kind: "normal"
    id: "screen_title"
    name: "title_screen"
    value_type: "Screen"
    initial_value: "screen_title"
  - kind: "normal"
    id: "screen_dialogue"
    name: "dialogue_screen"
    value_type: "Screen"
    initial_value: "screen_dialogue"
  - kind: "normal"
    id: "screen_backlog"
    name: "backlog_screen"
    value_type: "Screen"
    initial_value: "screen_backlog"
  - kind: "normal"
    id: "screen_settings"
    name: "settings_screen"
    value_type: "Screen"
    initial_value: "screen_settings"
  - kind: "normal"
    id: "screen_save_load"
    name: "save_load_screen"
    value_type: "Screen"
    initial_value: "screen_save_load"
requests: []
script: ".screens.title_screen.open().await()\n"
