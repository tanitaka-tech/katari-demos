              - id: "f_submit_t_s"
                color: "#2e4804"
                width: 4
            font_weight: 700
            align: "center"
    anchor_min_x: 0.5
    anchor_min_y: 0.5
    anchor_max_x: 0.5
    anchor_max_y: 0.5
variables:
  - kind: "normal"
    id: "trainer"
    name: "$trainer"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "gender"
    name: "$gender"
    value_type: "String"
    initial_value: "male"
  - kind: "normal"
    id: "registered"
    name: "$registered"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "opened"
    name: "$opened"
    value_type: "Int"
    initial_value: "0"
  - kind: "smart"
    id: "is_male"
    name: "$is_male"
    value_type: "Bool"
    expression: "$gender == \"male\""
  - kind: "smart"
    id: "is_female"
    name: "$is_female"
    value_type: "Bool"
    expression: "$gender == \"female\""
requests: []
script_graph:
  nodes:
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "opened"
        value: 1
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "set_variable_1"
  layout:
    - id: "set_variable_1"
      x: 260
      y: 0
