branding:
  companyName: ""
  productName: ""
  bundleIdentifier: ""
  version: "1.0.0"
appearance:
  macosIconPath: ""
  windowsIconPath: ""
  splashImagePath: ""
  splashBackground: "#000000"
  appAppearance: "auto"
  colorPalette[12]{id,name,color}:
    "head","head","#67bc01"
    "head_dark","head_dark","#4f9a00"
    "body","body","#f9f9f9"
    "pill","pill","#eee7e5"
    "ink","ink","#81532c"
    "hint","hint","#aba094"
    "warn","warn","#fb9e12"
    "input","input","#ffffff"
    "input_line","input_line","#d8d2cc"
    "on","on","#86ce23"
    "off","off","#dadadf"
    "btn","btn","#548307"
  numberPalette: []
  fontPalette:
    -
      id: "ui"
      name: "UI（丸ゴシック）"
      source:
        kind: "os"
        family: "Hiragino Maru Gothic ProN, Yu Gothic UI, Meiryo, M PLUS Rounded 1c, sans-serif"
  gradientPresets: []
  filterPresets: []
look:
  postEffects: []
player:
  width: 648
  height: 1152
  fullscreen: false
  autoAdvance: false
  autoAdvanceMs: 60
  skipUnreadText: false
  fps: 60
  particleQuality: 1
  pixelSnap: false
  tickMode: "fixed"
  tickHz: 60
  gpu: "webgl2"
platform:
  permissions:
    networkAccess: false
    fileSystemAccess: false
    microphoneAccess: false
  macos:
    hardenedRuntime: true
    enableMetal: true
  windows:
    enableHighDpi: true
    requestAdmin: false
scripting:
  backend: "default"
  apiCompatibility: "v1"
  managedStripping: "none"
  strictDialogueLint: true
editor:
  maxOverflowX: 1024
  maxOverflowY: 1024
audio:
  buses: []
assets:
  image_optimize:
    enabled: false
    max_dimension: 2048
    format: "auto"
    quality: 82
    reduce_colors: false
  video_sidecar: false
  external_assets: false
  bundle_unreferenced: false
  dynamic_refs: []
  smart_folders: []
  packs: []
save:
  groups: []
localization:
  sourceLocale: "ja"
  locales: []
  tables: []
  assetVariants: {}
storePage:
  platforms: []
initialScreen: "screen_form_ui_main"
startScene: ""
dialogueScreen: "screen_dialogue"
plugins: {}
vcs:
  lore:
    serverUrl: "lore://127.0.0.1:41337"
    autoStartLocalServer: true
network:
  allow: []
extensions: {}
vaults: []
