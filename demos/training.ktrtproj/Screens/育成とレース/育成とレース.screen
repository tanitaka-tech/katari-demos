screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "bg"
    name: "背景"
    type: "rectangle"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    fill: "#101826"
  - id: "title"
    name: "タイトル"
    type: "text"
    x: 48
    y: 40
    origin_x: 0
    origin_y: 0
    width: 900
    height: 44
    text: "育成シミュレーション デモ"
    font_size: 34
    color: "#ffd166"
  - id: "frame_train"
    name: "育成"
    type: "frame"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    children:
      - id: "val_turn"
        name: "val_turn"
        type: "text"
        x: 48
        y: 120
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "ターン  {$turn} / 12"
        font_size: 26
        color: "#ffd166"
      - id: "val_speed"
        name: "val_speed"
        type: "text"
        x: 48
        y: 190
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "スピード  {$speed}"
        font_size: 26
        color: "#f4f7fb"
      - id: "val_stamina"
        name: "val_stamina"
        type: "text"
        x: 48
        y: 240
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "スタミナ  {$stamina}"
        font_size: 26
        color: "#f4f7fb"
      - id: "val_guts"
        name: "val_guts"
        type: "text"
        x: 48
        y: 290
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "根性  {$guts}"
        font_size: 26
        color: "#f4f7fb"
      - id: "val_cond"
        name: "val_cond"
        type: "text"
        x: 48
        y: 340
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "体力  {$cond}"
        font_size: 26
        color: "#90be6d"
      - id: "log_text"
        name: "ログ"
        type: "text"
        x: 48
        y: 404
        origin_x: 0
        origin_y: 0
        width: 1100
        height: 34
        text: "$log"
        font_size: 24
        color: "#9fb3c8"
      - id: "btn_speed"
        name: "スピード練習"
        type: "button"
        x: 48
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "スピード練習"
        font_size: 24
        fill: "#3f6ea5"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_speed_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "speed"
      - id: "btn_stamina"
        name: "スタミナ練習"
        type: "button"
        x: 328
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "スタミナ練習"
        font_size: 24
        fill: "#3f6ea5"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_stamina_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "stamina"
      - id: "btn_guts"
        name: "根性練習"
        type: "button"
        x: 608
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "根性練習"
        font_size: 24
        fill: "#3f6ea5"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_guts_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "guts"
      - id: "btn_rest"
        name: "休む"
        type: "button"
        x: 888
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "休む"
        font_size: 24
        fill: "#31506e"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_rest_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "rest"
  - id: "frame_race"
    name: "レース"
    type: "frame"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    visible: false
    children:
      - id: "lane_self"
        name: "lane_self"
        type: "rectangle"
        x: 48
        y: 236
        origin_x: 0
        origin_y: 0
        width: 1132
        height: 6
        fill: "#23324a"
      - id: "lane_r1"
        name: "lane_r1"
        type: "rectangle"
        x: 48
        y: 336
        origin_x: 0
        origin_y: 0
        width: 1132
        height: 6
        fill: "#23324a"
      - id: "lane_r2"
        name: "lane_r2"
        type: "rectangle"
        x: 48
        y: 436
        origin_x: 0
        origin_y: 0
        width: 1132
        height: 6
        fill: "#23324a"
      - id: "goal"
        name: "ゴール"
        type: "rectangle"
        x: 1180
        y: 180
        origin_x: 0
        origin_y: 0
        width: 8
        height: 300
        fill: "#ffd166"
      - id: "run_self"
        name: "run_self"
        type: "rectangle"
        x: "$rx_self"
        y: 196
        origin_x: 0
        origin_y: 0
        width: 40
        height: 40
        fill: "#ff5a5a"
        corner_radius: 8
      - id: "run_r1"
        name: "run_r1"
        type: "rectangle"
        x: "$rx_r1"
        y: 296
        origin_x: 0
        origin_y: 0
        width: 40
        height: 40
        fill: "#4cc9f0"
        corner_radius: 8
      - id: "run_r2"
        name: "run_r2"
        type: "rectangle"
        x: "$rx_r2"
        y: 396
        origin_x: 0
        origin_y: 0
        width: 40
        height: 40
        fill: "#90be6d"
        corner_radius: 8
      - id: "result_text"
        name: "結果"
        type: "text"
        x: 48
        y: 520
        origin_x: 0
        origin_y: 0
        width: 1100
        height: 44
        text: "$result"
        font_size: 34
        color: "#ffd166"
variables:
  - kind: "normal"
    id: "phase"
    name: "$phase"
    value_type: "String"
    initial_value: "train"
  - kind: "normal"
    id: "turn"
    name: "$turn"
    value_type: "Int"
    initial_value: "1"
  - kind: "normal"
    id: "command"
    name: "$command"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "speed"
    name: "$speed"
    value_type: "Int"
    initial_value: "50"
  - kind: "normal"
    id: "stamina"
    name: "$stamina"
    value_type: "Int"
    initial_value: "50"
  - kind: "normal"
    id: "guts"
    name: "$guts"
    value_type: "Int"
    initial_value: "50"
  - kind: "normal"
    id: "cond"
    name: "$cond"
    value_type: "Int"
    initial_value: "100"
  - kind: "normal"
    id: "log"
    name: "$log"
    value_type: "String"
    initial_value: "練習を選んでターンを進めよう"
  - kind: "normal"
    id: "rx_self"
    name: "$rx_self"
    value_type: "Float"
    initial_value: "60"
  - kind: "normal"
    id: "rx_r1"
    name: "$rx_r1"
    value_type: "Float"
    initial_value: "60"
  - kind: "normal"
    id: "rx_r2"
    name: "$rx_r2"
    value_type: "Float"
    initial_value: "60"
  - kind: "normal"
    id: "rv_self"
    name: "$rv_self"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "rv_r1"
    name: "$rv_r1"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "rv_r2"
    name: "$rv_r2"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "result"
    name: "$result"
    value_type: "String"
    initial_value: ""
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "set_random_seed_1"
    - id: "set_random_seed_1"
      type: "set_random_seed"
      properties:
        seed: "uma-demo-2026"
    - id: "event_tick_1"
      type: "event_tick"
      next: "switch_on_string_1"
    - id: "switch_on_string_1"
      type: "switch_on_string"
      properties:
        selection: "$phase"
        case_count: 2
        case_0_value: "train"
        case_1_value: "race"
      next:
        case_0: "switch_on_string_2"
        case_1: "set_variable_21"
    - id: "switch_on_string_2"
      type: "switch_on_string"
      properties:
        selection: "$command"
        case_0_value: "speed"
        case_1_value: "stamina"
        case_2_value: "guts"
        case_3_value: "rest"
      next:
        case_0: "branch_1"
        case_1: "branch_2"
        case_2: "branch_3"
        case_3: "set_variable_13"
    - id: "float_ge_1"
      type: "float_ge"
      properties:
        a: "$cond"
        b: 16
    - id: "branch_1"
      type: "branch"
      next:
        true: "set_variable_1"
        false: "set_variable_3"
    - id: "random_float_range_1"
      type: "random_float_range"
      properties:
        min: 6
        max: 13
    - id: "float_add_1"
      type: "float_add"
      properties:
        a: "$speed"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "speed"
      next: "float_decrement_1"
    - id: "float_decrement_1"
      type: "float_decrement"
      properties:
        variable: "cond"
        amount: 16
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "log"
        value: "スピード練習！ 脚が軽い"
      next: "call_custom_event_1"
    - id: "call_custom_event_1"
      type: "call_custom_event"
      properties:
        event_name: "after_turn"
    - id: "random_float_range_2"
      type: "random_float_range"
      properties:
        min: 1
        max: 3
    - id: "float_add_2"
      type: "float_add"
      properties:
        a: "$speed"
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "speed"
      next: "set_variable_4"
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "log"
        value: "疲れていて身が入らない…"
      next: "call_custom_event_2"
    - id: "call_custom_event_2"
      type: "call_custom_event"
      properties:
        event_name: "after_turn"
    - id: "float_ge_2"
      type: "float_ge"
      properties:
        a: "$cond"
        b: 16
    - id: "branch_2"
      type: "branch"
      next:
        true: "set_variable_5"
        false: "set_variable_7"
    - id: "random_float_range_3"
      type: "random_float_range"
      properties:
        min: 6
        max: 13
    - id: "float_add_3"
      type: "float_add"
      properties:
        a: "$stamina"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "stamina"
      next: "float_decrement_2"
    - id: "float_decrement_2"
      type: "float_decrement"
      properties:
        variable: "cond"
        amount: 16
      next: "set_variable_6"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
        variable: "log"
        value: "スタミナ練習！ 息が続く"
      next: "call_custom_event_3"
    - id: "call_custom_event_3"
      type: "call_custom_event"
      properties:
        event_name: "after_turn"
    - id: "random_float_range_4"
      type: "random_float_range"
      properties:
        min: 1
        max: 3
    - id: "float_add_4"
      type: "float_add"
      properties:
        a: "$stamina"
    - id: "set_variable_7"
      type: "set_variable"
      properties:
        variable: "stamina"
      next: "set_variable_8"
    - id: "set_variable_8"
      type: "set_variable"
      properties:
        variable: "log"
        value: "疲れていて身が入らない…"
      next: "call_custom_event_4"
    - id: "call_custom_event_4"
      type: "call_custom_event"
      properties:
        event_name: "after_turn"
    - id: "float_ge_3"
      type: "float_ge"
      properties:
        a: "$cond"
        b: 16
    - id: "branch_3"
      type: "branch"
      next:
        true: "set_variable_9"
        false: "set_variable_11"
    - id: "random_float_range_5"
      type: "random_float_range"
      properties:
        min: 6
        max: 13
    - id: "float_add_5"
      type: "float_add"
      properties:
        a: "$guts"
    - id: "set_variable_9"
      type: "set_variable"
      properties:
        variable: "guts"
      next: "float_decrement_3"
    - id: "float_decrement_3"
      type: "float_decrement"
      properties:
        variable: "cond"
        amount: 16
      next: "set_variable_10"
    - id: "set_variable_10"
      type: "set_variable"
      properties:
        variable: "log"
        value: "根性練習！ 粘りが出た"
      next: "call_custom_event_5"
    - id: "call_custom_event_5"
      type: "call_custom_event"
      properties:
        event_name: "after_turn"
    - id: "random_float_range_6"
      type: "random_float_range"
      properties:
        min: 1
        max: 3
    - id: "float_add_6"
      type: "float_add"
      properties:
        a: "$guts"
    - id: "set_variable_11"
      type: "set_variable"
      properties:
        variable: "guts"
      next: "set_variable_12"
    - id: "set_variable_12"
      type: "set_variable"
      properties:
        variable: "log"
        value: "疲れていて身が入らない…"
      next: "call_custom_event_6"
    - id: "call_custom_event_6"
      type: "call_custom_event"
      properties:
        event_name: "after_turn"
    - id: "float_add_7"
      type: "float_add"
      properties:
        a: "$cond"
        b: 34
    - id: "float_clamp_1"
      type: "float_clamp"
      properties:
        min: 0
        max: 100
    - id: "set_variable_13"
      type: "set_variable"
      properties:
        variable: "cond"
      next: "set_variable_14"
    - id: "set_variable_14"
      type: "set_variable"
      properties:
        variable: "log"
        value: "休んで体力が戻った"
      next: "call_custom_event_7"
    - id: "call_custom_event_7"
      type: "call_custom_event"
      properties:
        event_name: "after_turn"
    - id: "float_gt_1"
      type: "float_gt"
      properties:
        a: "$turn"
        b: 12
    - id: "branch_4"
      type: "branch"
      next:
        true: "call_custom_event_8"
    - id: "custom_event_1"
      type: "custom_event"
      properties:
        event_name: "after_turn"
        parameters: "[]"
      next: "float_increment_1"
    - id: "float_increment_1"
      type: "float_increment"
      properties:
        variable: "turn"
      next: "set_variable_15"
    - id: "set_variable_15"
      type: "set_variable"
      properties:
        variable: "command"
        value: ""
      next: "branch_4"
    - id: "call_custom_event_8"
      type: "call_custom_event"
      properties:
        event_name: "start_race"
    - id: "custom_event_2"
      type: "custom_event"
      properties:
        event_name: "start_race"
        parameters: "[]"
      next: "set_variable_16"
    - id: "set_variable_16"
      type: "set_variable"
      properties:
        variable: "phase"
        value: "race"
      next: "hide_object_call_1"
    - id: "get_frame_reference_1"
      type: "get_frame_reference"
      properties:
        object_id: "frame_train"
    - id: "hide_object_call_1"
      type: "hide_object_call"
      next: "show_object_call_1"
    - id: "get_frame_reference_2"
      type: "get_frame_reference"
      properties:
        object_id: "frame_race"
    - id: "show_object_call_1"
      type: "show_object_call"
      next: "set_variable_17"
    - id: "float_mul_1"
      type: "float_mul"
      properties:
        a: "$speed"
        b: 0.9
    - id: "float_add_8"
      type: "float_add"
      properties:
        a: 150
    - id: "set_variable_17"
      type: "set_variable"
      properties:
        variable: "rv_self"
      next: "set_variable_18"
    - id: "random_float_range_7"
      type: "random_float_range"
      properties:
        min: 183
        max: 211
    - id: "set_variable_18"
      type: "set_variable"
      properties:
        variable: "rv_r1"
      next: "set_variable_19"
    - id: "random_float_range_8"
      type: "random_float_range"
      properties:
        min: 178
        max: 206
    - id: "set_variable_19"
      type: "set_variable"
      properties:
        variable: "rv_r2"
      next: "set_variable_20"
    - id: "set_variable_20"
      type: "set_variable"
      properties:
        variable: "log"
        value: "レース開始！"
    - id: "float_ge_4"
      type: "float_ge"
      properties:
        a: "$rx_self"
        b: 1140
    - id: "float_ge_5"
      type: "float_ge"
      properties:
        a: "$rx_r1"
        b: 1140
    - id: "or_op_1"
      type: "or_op"
    - id: "float_ge_6"
      type: "float_ge"
      properties:
        a: "$rx_r2"
        b: 1140
    - id: "or_op_2"
      type: "or_op"
    - id: "branch_5"
      type: "branch"
      next:
        true: "call_custom_event_9"
    - id: "float_mul_2"
      type: "float_mul"
      properties:
        a: "$rv_self"
    - id: "float_add_9"
      type: "float_add"
      properties:
        a: "$rx_self"
    - id: "set_variable_21"
      type: "set_variable"
      properties:
        variable: "rx_self"
      next: "set_variable_22"
    - id: "float_mul_3"
      type: "float_mul"
      properties:
        a: "$rv_r1"
    - id: "float_add_10"
      type: "float_add"
      properties:
        a: "$rx_r1"
    - id: "set_variable_22"
      type: "set_variable"
      properties:
        variable: "rx_r1"
      next: "set_variable_23"
    - id: "float_mul_4"
      type: "float_mul"
      properties:
        a: "$rv_r2"
    - id: "float_add_11"
      type: "float_add"
      properties:
        a: "$rx_r2"
    - id: "set_variable_23"
      type: "set_variable"
      properties:
        variable: "rx_r2"
      next: "branch_5"
    - id: "call_custom_event_9"
      type: "call_custom_event"
      properties:
        event_name: "finish_race"
    - id: "float_gt_2"
      type: "float_gt"
      properties:
        a: "$rx_r1"
        b: "$rx_self"
    - id: "ternary_1"
      type: "ternary"
      properties:
        true: 1
        false: 0
    - id: "float_add_12"
      type: "float_add"
      properties:
        a: 1
    - id: "float_gt_3"
      type: "float_gt"
      properties:
        a: "$rx_r2"
        b: "$rx_self"
    - id: "ternary_2"
      type: "ternary"
      properties:
        true: 1
        false: 0
    - id: "float_add_13"
      type: "float_add"
    - id: "custom_event_3"
      type: "custom_event"
      properties:
        event_name: "finish_race"
        parameters: "[]"
      next: "set_variable_24"
    - id: "float_round_1"
      type: "float_round"
    - id: "to_string_int_1"
      type: "to_string_int"
    - id: "append_string_1"
      type: "append_string"
      properties:
        a: "結果: "
    - id: "append_string_2"
      type: "append_string"
      properties:
        b: "着"
    - id: "set_variable_24"
      type: "set_variable"
      properties:
        variable: "result"
      next: "set_variable_25"
    - id: "set_variable_25"
      type: "set_variable"
      properties:
        variable: "phase"
        value: "done"
  layout:
    - id: "set_random_seed_1"
      x: 260
      y: 0
    - id: "event_tick_1"
      x: 0
      y: 130
    - id: "switch_on_string_1"
      x: 260
      y: 130
    - id: "switch_on_string_2"
      x: 520
      y: 0
    - id: "float_ge_1"
      x: 0
      y: 260
    - id: "branch_1"
      x: 780
      y: 0
    - id: "random_float_range_1"
      x: 0
      y: 390
    - id: "float_add_1"
      x: 260
      y: 260
    - id: "set_variable_1"
      x: 1040
      y: 0
    - id: "float_decrement_1"
      x: 1300
      y: 0
    - id: "set_variable_2"
      x: 1560
      y: 0
    - id: "call_custom_event_1"
      x: 1820
