screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "bg"
    name: "背景"
    type: "rectangle"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    fill: "#101826"
  - id: "title"
    name: "タイトル"
    type: "text"
    x: 48
    y: 40
    origin_x: 0
    origin_y: 0
    width: 900
    height: 44
    text: "育成シミュレーション デモ"
    font_size: 34
    color: "#ffd166"
  - id: "frame_train"
    name: "育成"
    type: "frame"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    children:
      - id: "val_turn"
        name: "val_turn"
        type: "text"
        x: 48
        y: 120
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "ターン  {$turn} / 12"
        font_size: 26
        color: "#ffd166"
      - id: "val_speed"
        name: "val_speed"
        type: "text"
        x: 48
        y: 190
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "スピード  {$speed}"
        font_size: 26
        color: "#f4f7fb"
      - id: "val_stamina"
        name: "val_stamina"
        type: "text"
        x: 48
        y: 240
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "スタミナ  {$stamina}"
        font_size: 26
        color: "#f4f7fb"
      - id: "val_guts"
        name: "val_guts"
        type: "text"
        x: 48
        y: 290
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "根性  {$guts}"
        font_size: 26
        color: "#f4f7fb"
      - id: "val_cond"
        name: "val_cond"
        type: "text"
        x: 48
        y: 340
        origin_x: 0
        origin_y: 0
        width: 520
        height: 34
        text: "体力  {$cond}"
        font_size: 26
        color: "#90be6d"
      - id: "log_text"
        name: "ログ"
        type: "text"
        x: 48
        y: 404
        origin_x: 0
        origin_y: 0
        width: 1100
        height: 34
        text: "$log"
        font_size: 24
        color: "#9fb3c8"
      - id: "btn_speed"
        name: "スピード練習"
        type: "button"
        x: 48
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "スピード練習"
        font_size: 24
        fill: "#3f6ea5"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_speed_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "speed"
      - id: "btn_stamina"
        name: "スタミナ練習"
        type: "button"
        x: 328
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "スタミナ練習"
        font_size: 24
        fill: "#3f6ea5"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_stamina_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "stamina"
      - id: "btn_guts"
        name: "根性練習"
        type: "button"
        x: 608
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "根性練習"
        font_size: 24
        fill: "#3f6ea5"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_guts_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "guts"
      - id: "btn_rest"
        name: "休む"
        type: "button"
        x: 888
        y: 470
        origin_x: 0
        origin_y: 0
        width: 260
        height: 72
        text: "休む"
        font_size: 24
        fill: "#31506e"
        color: "#ffffff"
        corner_radius: 12
        events:
          - id: "btn_rest_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "rest"
  - id: "frame_race"
    name: "レース"
    type: "frame"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    visible: false
    children:
      - id: "lane_self"
        name: "lane_self"
        type: "rectangle"
        x: 48
        y: 236
        origin_x: 0
        origin_y: 0
        width: 1132
        height: 6
        fill: "#23324a"
      - id: "lane_r1"
        name: "lane_r1"
        type: "rectangle"
        x: 48
        y: 336
        origin_x: 0
        origin_y: 0
        width: 1132
        height: 6
        fill: "#23324a"
      - id: "lane_r2"
        name: "lane_r2"
        type: "rectangle"
        x: 48
        y: 436
        origin_x: 0
        origin_y: 0
        width: 1132
        height: 6
        fill: "#23324a"
      - id: "goal"
        name: "ゴール"
        type: "rectangle"
        x: 1180
        y: 180
        origin_x: 0
        origin_y: 0
        width: 8
        height: 300
        fill: "#ffd166"
      - id: "run_self"
        name: "run_self"
        type: "rectangle"
        x: "$rx_self"
        y: 196
        origin_x: 0
        origin_y: 0
        width: 40
        height: 40
        fill: "#ff5a5a"
        corner_radius: 8
      - id: "run_r1"
        name: "run_r1"
        type: "rectangle"
        x: "$rx_r1"
        y: 296
        origin_x: 0
        origin_y: 0
        width: 40
        height: 40
        fill: "#4cc9f0"
        corner_radius: 8
      - id: "run_r2"
        name: "run_r2"
        type: "rectangle"
        x: "$rx_r2"
        y: 396
        origin_x: 0
        origin_y: 0
        width: 40
        height: 40
        fill: "#90be6d"
        corner_radius: 8
      - id: "result_text"
        name: "結果"
        type: "text"
        x: 48
        y: 520
        origin_x: 0
        origin_y: 0
        width: 1100
        height: 44
        text: "$result"
        font_size: 34
        color: "#ffd166"
variables:
  - kind: "normal"
    id: "phase"
    name: "$phase"
    value_type: "String"
    initial_value: "train"
  - kind: "normal"
    id: "turn"
    name: "$turn"
    value_type: "Int"
    initial_value: "1"
  - kind: "normal"
    id: "command"
    name: "$command"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "speed"
    name: "$speed"
    value_type: "Int"
    initial_value: "50"
  - kind: "normal"
    id: "stamina"
    name: "$stamina"
    value_type: "Int"
    initial_value: "50"
  - kind: "normal"
    id: "guts"
    name: "$guts"
    value_type: "Int"
    initial_value: "50"
  - kind: "normal"
    id: "cond"
    name: "$cond"
    value_type: "Int"
    initial_value: "100"
  - kind: "normal"
    id: "log"
    name: "$log"
    value_type: "String"
    initial_value: "練習を選んでターンを進めよう"
  - kind: "normal"
    id: "rx_self"
    name: "$rx_self"
    value_type: "Float"
    initial_value: "60"
  - kind: "normal"
    id: "rx_r1"
    name: "$rx_r1"
    value_type: "Float"
    initial_value: "60"
  - kind: "normal"
    id: "rx_r2"
    name: "$rx_r2"
    value_type: "Float"
    initial_value: "60"
  - kind: "normal"
    id: "rv_self"
    name: "$rv_self"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "rv_r1"
    name: "$rv_r1"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "rv_r2"
    name: "$rv_r2"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "result"
    name: "$result"
    value_type: "String"
    initial_value: ""
requests: []
script: ".random.seed(seed=\"uma-demo-2026\")\n.events.tick.subscribe\n\tif phase == \"train\"\n\t\tif command == \"speed\"\n\t\t\tif (cond >= 16)\n\t\t\t\tspeed = (speed + random_float_range(min=6, max=13))\n\t\t\t\tcond -= 16\n\t\t\t\tlog = \"スピード練習！ 脚が軽い\"\n\t\t\t\t.events.after_turn.emit(\"\")\n\t\t\telse\n\t\t\t\tspeed = (speed + random_float_range(min=1, max=3))\n\t\t\t\tlog = \"疲れていて身が入らない…\"\n\t\t\t\t.events.after_turn.emit(\"\")\n\t\telif command == \"stamina\"\n\t\t\tif (cond >= 16)\n\t\t\t\tstamina = (stamina + random_float_range(min=6, max=13))\n\t\t\t\tcond -= 16\n\t\t\t\tlog = \"スタミナ練習！ 息が続く\"\n\t\t\t\t.events.after_turn.emit(\"\")\n\t\t\telse\n\t\t\t\tstamina = (stamina + random_float_range(min=1, max=3))\n\t\t\t\tlog = \"疲れていて身が入らない…\"\n\t\t\t\t.events.after_turn.emit(\"\")\n\t\telif command == \"guts\"\n\t\t\tif (cond >= 16)\n\t\t\t\tguts = (guts + random_float_range(min=6, max=13))\n\t\t\t\tcond -= 16\n\t\t\t\tlog = \"根性練習！ 粘りが出た\"\n\t\t\t\t.events.after_turn.emit(\"\")\n\t\t\telse\n\t\t\t\tguts = (guts + random_float_range(min=1, max=3))\n\t\t\t\tlog = \"疲れていて身が入らない…\"\n\t\t\t\t.events.after_turn.emit(\"\")\n\t\telif command == \"rest\"\n\t\t\tcond = float_clamp(value=(cond + 34), min=0, max=100)\n\t\t\tlog = \"休んで体力が戻った\"\n\t\t\t.events.after_turn.emit(\"\")\n\telif phase == \"race\"\n\t\trx_self = (rx_self + (rv_self * dt))\n\t\trx_r1 = (rx_r1 + (rv_r1 * dt))\n\t\trx_r2 = (rx_r2 + (rv_r2 * dt))\n\t\tif (((rx_self >= 1140) || (rx_r1 >= 1140)) || (rx_r2 >= 1140))\n\t\t\t.events.finish_race.emit(\"\")\n.events.after_turn.subscribe\n\tturn += 1\n\tcommand = \"\"\n\tif (turn > 12)\n\t\t.events.start_race.emit(\"\")\n.events.start_race.subscribe\n\tphase = \"race\"\n\t.objects.frame_train.hide()\n\t.objects.frame_race.show()\n\trv_self = (150 + (speed * 0.9))\n\trv_r1 = random_float_range(min=183, max=211)\n\trv_r2 = random_float_range(min=178, max=206)\n\tlog = \"レース開始！\"\n.events.finish_race.subscribe\n\tresult = ((\"結果: \" + to_string_int(a=float_round(a=((1 + ((rx_r1 > rx_self) ? 1 : 0)) + ((rx_r2 > rx_self) ? 1 : 0))))) + \"着\")\n\tphase = \"done\"\n"
