        pin: "a"
    - from:
        nodeId: "mv_dt"
        pin: "return"
      to:
        nodeId: "mv_dy"
        pin: "b"
    - from:
        nodeId: "px_get"
        pin: "value"
      to:
        nodeId: "px_add"
        pin: "a"
    - from:
        nodeId: "mv_dx"
        pin: "return"
      to:
        nodeId: "px_add"
        pin: "b"
    - from:
        nodeId: "py_get"
        pin: "value"
      to:
        nodeId: "py_add"
        pin: "a"
    - from:
        nodeId: "mv_dy"
        pin: "return"
      to:
        nodeId: "py_add"
        pin: "b"
    - from:
        nodeId: "px_add"
        pin: "return"
      to:
        nodeId: "px_clamp"
        pin: "value"
    - from:
        nodeId: "edge_lo"
        pin: "value"
      to:
        nodeId: "px_clamp"
        pin: "min"
    - from:
        nodeId: "edge_hi_x"
        pin: "value"
      to:
        nodeId: "px_clamp"
        pin: "max"
    - from:
        nodeId: "px_clamp"
        pin: "return"
      to:
        nodeId: "px_set"
        pin: "value"
    - from:
        nodeId: "py_add"
        pin: "return"
      to:
        nodeId: "py_clamp"
        pin: "value"
    - from:
        nodeId: "edge_lo"
        pin: "value"
      to:
        nodeId: "py_clamp"
        pin: "min"
    - from:
        nodeId: "edge_hi_y"
        pin: "value"
      to:
