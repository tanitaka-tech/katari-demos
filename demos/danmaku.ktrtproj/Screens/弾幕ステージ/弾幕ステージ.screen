screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "bg"
    name: "背景"
    type: "rectangle"
    origin_x: 0
    origin_y: 0
    x: 0
    y: 0
    width: 1280
    height: 720
    fill: "#0b0d1a"
  - id: "swarm"
    name: "弾"
    type: "swarm"
    origin_x: 0
    origin_y: 0
    x: 0
    y: 0
    width: 1280
    height: 720
    source: "table:bullets"
    grain: "circle"
    grain_size: 10
    color: "#ff5ea8"
  - id: "player"
    name: "自機"
    type: "rectangle"
    x: "$px"
    y: "$py"
    origin_x: 0.5
    origin_y: 0.5
    width: 22
    height: 22
    fill: "#8ee7ff"
  - id: "hitbox"
    name: "自機の判定"
    type: "rectangle"
    x: "$px"
    y: "$py"
    origin_x: 0.5
    origin_y: 0.5
    width: 10
    height: 10
    corner_radius: 5
    fill: "#ff3355"
  - id: "hud"
    name: "被弾数"
    type: "text"
    origin_x: 0
    origin_y: 0
    x: 24
    y: 20
    width: 320
    height: 40
    text: "被弾 {$hits}   グレイズ {$graze}"
    font_size: 24
    color: "#ffffff"
variables:
  - id: "px"
    name: "$px"
    kind: "normal"
    value_type: "Float"
    initial_value: "640"
  - id: "py"
    name: "$py"
    kind: "normal"
    value_type: "Float"
    initial_value: "580"
  - id: "move"
    name: "$move"
    kind: "normal"
    value_type: "Vector2"
    initial_value: "0,0"
  - id: "hits"
    name: "$hits"
    kind: "normal"
    value_type: "Float"
    initial_value: "0"
  - id: "graze"
    name: "$graze"
    kind: "normal"
    value_type: "Float"
    initial_value: "0"
  - id: "spin"
    name: "$spin"
    kind: "normal"
    value_type: "Float"
    initial_value: "0"
requests: []
script: ".input.map_gameplay.act_move.subscribe v_1 =>\n\tmove = v_1\nh_2 = pattern.launch()\n.events.tick.subscribe\n\tpx = float_clamp(value=(px + (move.x * (dt * 320))), min=24, max=1256)\n\tpy = float_clamp(value=(py + (move.y * (dt * 320))), min=24, max=696)\n\t.tables.bullets.advance(target=x, delta=vx)\n\t.tables.bullets.advance(target=y, delta=vy)\n\t.tables.bullets.remove_where(field=x, op=\"<\", value=-60)\n\t.tables.bullets.remove_where(field=x, op=\">\", value=1340)\n\t.tables.bullets.remove_where(field=y, op=\"<\", value=-60)\n\t.tables.bullets.remove_where(field=y, op=\">\", value=780)\n\tif (array_length(overlap_circle_2d_split(\"table:bullets\", px, py, 5, 14, \"hit\")) > 0)\n\t\thits += 1\n\t\t.time.game.freeze(seconds=0.2)\n\telse\n\t\tgraze = (graze + array_length(overlap_circle_2d_split(\"table:bullets\", px, py, 5, 14, \"near\")))\n\nfunction pattern()\n\twhile true\n\t\tfor i_3 in 0..31\n\t\t\t.tables.bullets.add_row(x=640, y=140, vx=vec2_from_angle(((i_3 * 11.25) + spin), 3.2).x, vy=vec2_from_angle(((i_3 * 11.25) + spin), 3.2).y, r=5)\n\t\tspin = (spin + 9)\n\t\twait_frames(4).await()\n"
