      to:
        nodeId: "mv_dt"
        pin: "a"
    - from:
        nodeId: "sp"
        pin: "value"
      to:
        nodeId: "mv_dt"
        pin: "b"
    - from:
        nodeId: "mv_break"
        pin: "x"
      to:
        nodeId: "mv_dx"
        pin: "a"
    - from:
        nodeId: "mv_dt"
        pin: "return"
      to:
        nodeId: "mv_dx"
        pin: "b"
    - from:
