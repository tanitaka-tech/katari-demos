screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "bg"
    name: "背景"
    type: "rectangle"
    origin_x: 0
    origin_y: 0
    x: 0
    y: 0
    width: 1280
    height: 720
    fill: "#120b1c"
  - id: "claim"
    name: "証言"
    type: "text"
    x: "$cx"
    y: 300
    origin_x: 0
    origin_y: 0
    width: 460
    height: 64
    text: "犯人は[color=#ff5e6c]鍵のかかった[/color]部屋から出られない"
    font_size: 24
    color: "#ffffff"
    text_align: "left"
    collider:
      layer: "claim"
  - id: "aim"
    name: "照準"
    type: "rectangle"
    x: "$ax"
    y: "$ay"
    origin_x: 0.5
    origin_y: 0.5
    width: 40
    height: 40
    corner_radius: 20
    fill: "#00000000"
    stroke: "#7ce7ff"
    stroke_width: 3
  - id: "talk"
    name: "導入の台詞"
    type: "text"
    x: 60
    y: 560
    origin_x: 0
    origin_y: 0
    width: 1160
    height: 100
    text: "……いいか、[wait=0.5]よく聞け。[speed=0.6]この証言には[color=#ff5e6c]決定的な矛盾[/color]がある。"
    font_size: 28
    color: "#ffffff"
    text_align: "left"
    reveal: "$reveal"
  - id: "hud"
    name: "残り時間"
    type: "text"
    origin_x: 0
    origin_y: 0
    x: 1020
    y: 24
    width: 220
    height: 44
    text: "残り {$time_text} 秒"
    font_size: 28
    color: "#ffd479"
    text_align: "right"
  - id: "score"
    name: "成績"
    type: "text"
    origin_x: 0
    origin_y: 0
    x: 40
    y: 24
    width: 320
    height: 44
    text: "命中 {$hits} / 発射 {$shots}"
    font_size: 24
    color: "#c9b7e0"
    text_align: "left"
variables:
  - id: "ax"
    name: "$ax"
    kind: "normal"
    value_type: "Float"
    initial_value: "640"
  - id: "ay"
    name: "$ay"
    kind: "normal"
    value_type: "Float"
    initial_value: "332"
  - id: "move"
    name: "$move"
    kind: "normal"
    value_type: "Vector2"
    initial_value: "0,0"
  - id: "fire"
    name: "$fire"
    kind: "normal"
    value_type: "Bool"
    initial_value: "false"
  - id: "fired"
    name: "$fired"
    kind: "normal"
    value_type: "Bool"
    initial_value: "false"
  - id: "cx"
    name: "$cx"
    kind: "normal"
    value_type: "Float"
    initial_value: "1280"
  - id: "talk_t"
    name: "$talk_t"
    kind: "normal"
    value_type: "Float"
    initial_value: "0"
  - id: "reveal"
    name: "$reveal"
    kind: "normal"
    value_type: "Float"
    initial_value: "0"
  - id: "time_left"
    name: "$time_left"
    kind: "normal"
    value_type: "Float"
    initial_value: "20"
  - id: "time_text"
    name: "$time_text"
    kind: "normal"
    value_type: "String"
    initial_value: "20"
  - id: "shots"
    name: "$shots"
    kind: "normal"
    value_type: "Float"
    initial_value: "0"
  - id: "hits"
    name: "$hits"
    kind: "normal"
    value_type: "Float"
    initial_value: "0"
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_vector2_1"
    - id: "get_input_action_vector2_1"
      type: "get_input_action_vector2"
      properties:
        actionMap: "map_gameplay"
        action: "act_move"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Vector2\"]"
      next: "set_variable_1"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "move"
    - id: "subscribe_vector2_1"
      type: "subscribe_vector2"
      next: "subscribe_bool_1"
    - id: "get_input_action_bool_1"
      type: "get_input_action_bool"
      properties:
        actionMap: "map_gameplay"
        action: "act_jump"
    - id: "lambda_2"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Bool\"]"
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "fire"
    - id: "subscribe_bool_1"
      type: "subscribe_bool"
    - id: "event_tick_1"
      type: "event_tick"
      next: "set_variable_3"
    - id: "get_variable_float_1"
      type: "get_variable_float"
      properties:
        variable: "talk_t"
    - id: "float_add_1"
      type: "float_add"
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "talk_t"
      next: "set_variable_4"
    - id: "get_variable_float_2"
      type: "get_variable_float"
      properties:
        variable: "talk_t"
    - id: "reveal_progress_1"
      type: "reveal_progress"
      properties:
        text: "……いいか、[wait=0.5]よく聞け。[speed=0.6]この証言には[color=#ff5e6c]決定的な矛盾[/color]がある。"
        chars_per_second: 26
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "reveal"
      next: "set_variable_5"
    - id: "get_variable_float_3"
