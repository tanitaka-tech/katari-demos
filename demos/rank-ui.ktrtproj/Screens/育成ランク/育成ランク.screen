variables:
  - kind: "normal"
    id: "score"
    name: "$score"
    value_type: "Int"
    initial_value: "1343"
  - kind: "normal"
    id: "gauge_w"
    name: "$gauge_w"
    value_type: "Float"
    initial_value: "36"
  - kind: "normal"
    id: "next"
    name: "$next"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "opened"
    name: "$opened"
    value_type: "Int"
    initial_value: "0"
requests: []
script_graph:
  nodes:
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "opened"
        value: 1
      next: "subscribe_1"
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "set_variable_1"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Float\"]"
      next: "set_variable_2"
    - id: "on_tick_1"
      type: "on_tick"
    - id: "subscribe_1"
      type: "subscribe"
    - id: "float_mul_1"
      type: "float_mul"
      properties:
        b: 90
    - id: "float_add_1"
      type: "float_add"
      properties:
        a: "$gauge_w"
    - id: "float_clamp_1"
      type: "float_clamp"
      properties:
        min: 0
        max: 362
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "gauge_w"
  layout:
    - id: "set_variable_1"
      x: 260
      y: 0
    - id: "lambda_1"
      x: 0
      y: 130
    - id: "on_tick_1"
      x: 0
      y: 260
    - id: "subscribe_1"
      x: 520
      y: 0
    - id: "float_mul_1"
      x: 260
      y: 130
    - id: "float_add_1"
      x: 520
      y: 130
    - id: "float_clamp_1"
      x: 780
      y: 0
    - id: "set_variable_2"
      x: 1040
      y: 0
  edges:
    - from:
        nodeId: "on_tick_1"
        pin: "value"
      to:
        nodeId: "subscribe_1"
        pin: "source"
    - from:
        nodeId: "lambda_1"
        pin: "function"
      to:
        nodeId: "subscribe_1"
        pin: "on_next"
    - from:
        nodeId: "lambda_1"
        pin: "value_0"
      to:
        nodeId: "float_mul_1"
        pin: "a"
    - from:
        nodeId: "float_mul_1"
        pin: "return"
      to:
        nodeId: "float_add_1"
        pin: "b"
    - from:
        nodeId: "float_add_1"
        pin: "return"
      to:
        nodeId: "float_clamp_1"
        pin: "value"
    - from:
        nodeId: "float_clamp_1"
        pin: "return"
      to:
        nodeId: "set_variable_2"
        pin: "value"
