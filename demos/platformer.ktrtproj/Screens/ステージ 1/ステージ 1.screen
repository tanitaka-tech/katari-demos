  - id: "player"
    name: "プレイヤー"
    type: "rectangle"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 32
    fill: "#ff5a5a"
  - id: "camera"
    name: "カメラ"
    type: "camera"
    x: "$cam.x"
    y: "$cam.y"
    width: 1280
    height: 720
variables:
  - kind: "normal"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "64"
  - kind: "normal"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "160"
  - kind: "normal"
    id: "vx"
    name: "$vx"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "vy"
    name: "$vy"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "on_ground"
    name: "$on_ground"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "move"
    name: "$move"
    value_type: "Vector2"
    initial_value: "0,0"
  - kind: "normal"
    id: "jump"
    name: "$jump"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "cam"
    name: "$cam"
    value_type: "Vector2"
    initial_value: "640,360"
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_vector2_1"
    - id: "get_input_action_vector2_1"
      type: "get_input_action_vector2"
      properties:
        actionMap: "map_gameplay"
        action: "act_move"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Vector2\"]"
      next: "set_variable_1"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "move"
    - id: "subscribe_vector2_1"
      type: "subscribe_vector2"
      next: "subscribe_bool_1"
    - id: "get_input_action_bool_1"
      type: "get_input_action_bool"
      properties:
        actionMap: "map_gameplay"
        action: "act_jump"
    - id: "lambda_2"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Bool\"]"
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "jump"
    - id: "subscribe_bool_1"
      type: "subscribe_bool"
      next: "subscribe_float_1"
    - id: "lambda_3"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Float\"]"
      next: "set_variable_3"
    - id: "on_tick_1"
      type: "on_tick"
    - id: "subscribe_float_1"
      type: "subscribe_float"
    - id: "get_variable_vector2_1"
      type: "get_variable_vector2"
      properties:
        variable: "move"
    - id: "break_vector2_1"
      type: "break_vector2"
    - id: "float_mul_1"
      type: "float_mul"
      properties:
        b: 220
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "vx"
      next: "set_variable_4"
    - id: "get_variable_float_1"
      type: "get_variable_float"
      properties:
        variable: "vy"
    - id: "float_mul_2"
      type: "float_mul"
      properties:
        a: 1400
    - id: "float_add_1"
      type: "float_add"
    - id: "float_min_1"
      type: "float_min"
      properties:
        b: 900
    - id: "get_variable_bool_1"
      type: "get_variable_bool"
      properties:
        variable: "on_ground"
    - id: "get_variable_bool_2"
      type: "get_variable_bool"
      properties:
        variable: "jump"
    - id: "and_op_1"
      type: "and_op"
    - id: "ternary_1"
      type: "ternary"
      properties:
        true: -520
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "vy"
      next: "set_variable_5"
    - id: "get_colliders_1"
      type: "get_colliders"
      properties:
        layer: "solid"
    - id: "get_variable_float_2"
      type: "get_variable_float"
      properties:
        variable: "px"
    - id: "get_variable_float_3"
      type: "get_variable_float"
      properties:
