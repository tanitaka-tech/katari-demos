    tile_textures: []
    tile_colors:
      - "#6b4a2f"
      - "#b5651d"
      - "#6b4a2f"
      - "#6b4a2f"
    slope_up_tiles:
      - 2
    slope_down_tiles:
      - 3
  - id: "player"
    name: "プレイヤー"
    type: "rectangle"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 32
    fill: "#ff5a5a"
  - id: "camera"
    name: "カメラ"
    type: "camera"
    x: "$cam.x"
    y: "$cam.y"
    width: 1280
    height: 720
variables:
  - kind: "normal"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "64"
  - kind: "normal"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "160"
  - kind: "normal"
    id: "vx"
    name: "$vx"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "vy"
    name: "$vy"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "on_ground"
    name: "$on_ground"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "move"
    name: "$move"
    value_type: "Vector2"
    initial_value: "0,0"
  - kind: "normal"
    id: "jump"
    name: "$jump"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "cam"
    name: "$cam"
    value_type: "Vector2"
    initial_value: "640,360"
requests: []
script: ".input.map_gameplay.act_move.subscribe v_1 =>\n\tmove = v_1\n.input.map_gameplay.act_jump.subscribe v_2 =>\n\tjump = v_2\n.events.tick.subscribe\n\tvx = (move.x * 220)\n\tvy = ((on_ground && jump) ? -520 : float_min(a=(vy + (1400 * dt)), b=900))\n\tpx = move_collide_2d_pos(__colliders_solid, px, py, 24, 32, (vx * dt), (vy * dt), 0).x\n\tpy = move_collide_2d_pos(__colliders_solid, px, py, 24, 32, (vx * dt), (vy * dt), 0).y\n\ton_ground = move_collide_2d_field(__colliders_solid, px, py, 24, 32, (vx * dt), (vy * dt), 0, \"on_ground\")\n\tvy = ((move_collide_2d_field(__colliders_solid, px, py, 24, 32, (vx * dt), (vy * dt), 0, \"hit_top\") || move_collide_2d_field(__colliders_solid, px, py, 24, 32, (vx * dt), (vy * dt), 0, \"hit_bottom\")) ? 0 : ((on_ground && jump) ? -520 : float_min(a=(vy + (1400 * dt)), b=900)))\n\tcam = cam_clamp_bounds_2d((cam_follow_2d(cam, (make_vec2((move_collide_2d_pos(__colliders_solid, px, py, 24, 32, (vx * dt), (vy * dt), 0).x + 12), (move_collide_2d_pos(__colliders_solid, px, py, 24, 32, (vx * dt), (vy * dt), 0).y + 16))), 160, 90, 8, dt)), 1280, 720, 0, 0, 2560, 384)\n"
