    - id: "get_variable_float_5"
      type: "get_variable_float"
      properties:
        variable: "vy"
    - id: "float_mul_4"
      type: "float_mul"
    - id: "move_and_collide_1"
      type: "move_and_collide"
      properties:
        width: 24
        height: 32
    - id: "break_vector2_2"
      type: "break_vector2"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "px"
      next: "set_variable_6"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
