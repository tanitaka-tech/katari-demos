id: "text-anim-piece"
name: "テキスト演出"
piece_type: "object"
width: 620
height: 120
variables:
  -
    id: "label"
    kind: "input"
    name: "label"
    value_type: "String"
    required: false
    initial_value: "テキストを入力"
root:
  id: "text-anim-piece-root"
  name: "root"
  type: "frame"
  x: 0
  y: 0
  width: 620
  height: 120
  origin_x: 0
  origin_y: 0
  children:
    -
      id: "text-anim-body"
      name: "本文"
      type: "text"
      x: 310
      y: 60
      origin_x: 0.5
      origin_y: 0.5
      width: 620
      height: 120
      text: "$label"
      font_family: "@text-anim-font"
      font_size: 44
      letter_spacing: 20
      color: "#ffffff"
      strokes:
        -
          id: "ink"
          color: "#ffffff"
          width: 0.5
      text_align: "center"
      text_v_align: "middle"
      text_modifiers:
        -
          id: "g0"
          name: "字1"
          ranges:
            -
              id: "r0"
              name: "字1"
              unit: "grapheme"
              basis: "index"
              start: 0
              end: 1
              offset: 0
              feather_in: 0
              feather_out: 0
              strength: 1
          strength: 1
          opacity: 1
          position:
            x: 0
            y: 0
          scale:
            x: 1
            y: 1
          origin:
            x: 0.5
            y: 0.5
        -
          id: "g1"
          name: "字2"
          ranges:
            -
              id: "r1"
              name: "字2"
              unit: "grapheme"
              basis: "index"
              start: 1
              end: 2
              offset: 0
              feather_in: 0
              feather_out: 0
              strength: 1
          strength: 1
          opacity: 1
          position:
            x: 0
            y: 0
          scale:
            x: 1
            y: 1
          origin:
            x: 0.5
            y: 0.5
        -
          id: "g2"
          name: "字3"
          ranges:
            -
              id: "r2"
              name: "字3"
              unit: "grapheme"
              basis: "index"
