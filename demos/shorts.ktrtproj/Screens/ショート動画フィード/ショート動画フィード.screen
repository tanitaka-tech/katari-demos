requests: []
script_graph:
  nodes:
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Float\"]"
      next: "set_variable_1"
    - id: "on_tick_1"
      type: "on_tick"
    - id: "subscribe_1"
      type: "subscribe"
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_1"
    - id: "float_mul_1"
      type: "float_mul"
      properties:
        b: 90
    - id: "float_add_1"
      type: "float_add"
      properties:
        a: "$spin"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "spin"
      next: "set_variable_2"
    - id: "float_add_2"
      type: "float_add"
      properties:
        a: "$bounce_t"
    - id: "float_mod_1"
      type: "float_mod"
      properties:
        b: 2
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "bounce_t"
      next: "set_variable_3"
    - id: "float_sub_1"
      type: "float_sub"
      properties:
        a: "$bounce_t"
        b: 1
    - id: "float_abs_1"
      type: "float_abs"
    - id: "float_mul_2"
      type: "float_mul"
      properties:
        a: 60
    - id: "float_add_3"
      type: "float_add"
      properties:
        a: 430
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "bounce"
      next: "set_variable_4"
    - id: "array_get_1"
      type: "array_get"
      properties:
        array: "$users"
        index: "$page"
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "user"
      next: "set_variable_5"
    - id: "array_get_2"
      type: "array_get"
      properties:
        array: "$captions"
        index: "$page"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "caption"
      next: "set_variable_6"
    - id: "array_get_3"
      type: "array_get"
      properties:
        array: "$musics"
        index: "$page"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
        variable: "music"
      next: "set_variable_7"
    - id: "array_get_4"
      type: "array_get"
      properties:
        array: "$likes"
        index: "$page"
    - id: "set_variable_7"
      type: "set_variable"
      properties:
        variable: "like_count"
      next: "set_variable_8"
    - id: "array_get_5"
      type: "array_get"
      properties:
        array: "$comment_counts"
        index: "$page"
    - id: "set_variable_8"
      type: "set_variable"
      properties:
        variable: "comment_count"
      next: "set_variable_9"
    - id: "array_get_6"
      type: "array_get"
      properties:
        array: "$avatars"
        index: "$page"
    - id: "set_variable_9"
      type: "set_variable"
      properties:
        variable: "avatar"
      next: "set_variable_10"
    - id: "int_eq_1"
      type: "int_eq"
      properties:
        a: "$page"
        b: 0
    - id: "set_variable_10"
      type: "set_variable"
      properties:
        variable: "play0"
      next: "set_variable_11"
    - id: "int_eq_2"
      type: "int_eq"
      properties:
        a: "$page"
        b: 1
    - id: "set_variable_11"
      type: "set_variable"
      properties:
        variable: "play1"
      next: "set_variable_12"
    - id: "int_eq_3"
      type: "int_eq"
      properties:
        a: "$page"
        b: 2
    - id: "set_variable_12"
      type: "set_variable"
      properties:
        variable: "play2"
      next: "set_variable_13"
    - id: "int_eq_4"
      type: "int_eq"
      properties:
        a: "$page"
        b: 3
    - id: "set_variable_13"
      type: "set_variable"
      properties:
        variable: "play3"
      next: "set_variable_14"
    - id: "int_eq_5"
      type: "int_eq"
      properties:
        a: "$page"
        b: 4
    - id: "set_variable_14"
      type: "set_variable"
      properties:
        variable: "play4"
      next: "set_variable_15"
    - id: "float_max_1"
      type: "float_max"
      properties:
        a: "$vdur"
        b: 0.001
    - id: "float_div_1"
      type: "float_div"
      properties:
        a: "$vpos"
    - id: "float_mul_3"
      type: "float_mul"
      properties:
        a: 366
    - id: "set_variable_15"
      type: "set_variable"
      properties:
        variable: "prog_w"
      next: "switch_on_string_1"
    - id: "switch_on_string_1"
      type: "switch_on_string"
      properties:
        selection: "$command"
        case_count: 4
        case_0_value: "like"
        case_1_value: "comments"
        case_2_value: "profile"
        case_3_value: "close"
      next:
        case_0: "float_increment_1"
        case_1: "set_variable_18"
        case_2: "set_variable_20"
        case_3: "set_variable_22"
    - id: "float_increment_1"
      type: "float_increment"
      properties:
        variable: "like_count"
      next: "set_variable_16"
    - id: "array_set_1"
      type: "array_set"
      properties:
