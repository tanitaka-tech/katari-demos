screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "backdrop"
    name: "backdrop"
    type: "rectangle"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    fill: "#07070b"
  - id: "hint"
    name: "hint"
    type: "text"
    x: 20
    y: 48
    origin_x: 0
    origin_y: 0
    width: 400
    height: 29
    text: "指で上下に払うと 1 本ずつ送れる"
    font_size: 18
    color: "#8a8aa0"
  - id: "hint2"
    name: "hint2"
    type: "text"
    x: 20
    y: 92
    origin_x: 0
    origin_y: 0
    width: 400
    height: 24
    text: "速く払えば少しの動きでも次へ\nゆっくりなら元の位置へ戻る"
    font_size: 15
    color: "#6b6b82"
  - id: "hint3"
    name: "hint3"
    type: "text"
    x: 20
    y: 148
    origin_x: 0
    origin_y: 0
    width: 400
    height: 24
    text: "いいね / コメント / プロフも触れる"
    font_size: 15
    color: "#6b6b82"
  - id: "feed"
    name: "フィード"
    type: "frame"
    x: 437
    y: 0
    origin_x: 0
    origin_y: 0
    width: 406
    height: 720
    fill: "#000000"
    scroll:
      axis: "vertical"
      snap:
        index_variable: "page"
      end_variable: "more"
    children:
      - id: "post0"
        name: "投稿 1"
        type: "frame"
        x: 0
        y: 0
        origin_x: 0
        origin_y: 0
        width: 406
        height: 720
        fill: "#00000000"
        children:
          - id: "p0_bg"
            name: "p0_bg"
            type: "rectangle"
            x: 0
            y: 0
            origin_x: 0
            origin_y: 0
            width: 406
            height: 720
            fill: "#1b1033"
          - id: "p0_video"
            name: "p0_video"
            type: "video"
            video: "Films/clip-1.mp4"
            playing: "$play0"
            loop: true
            muted: true
            fit: "cover"
            x: 0
            y: 0
            origin_x: 0
            origin_y: 0
            width: 406
            height: 720
            position_variable: "vpos"
            duration_variable: "vdur"
          - id: "p0_ball"
            name: "p0_ball"
            type: "rectangle"
            x: 203
            y: "$bounce"
            origin_x: 0.5
            origin_y: 0.5
            width: 56
            height: 56
            fill: "#c9b8ff"
            corner_radius: 28
          - id: "p0_no"
            name: "p0_no"
            type: "text"
            x: 310
            y: 26
            origin_x: 0
            origin_y: 0
            width: 80
            height: 29
            text: "1 / 5"
            font_size: 18
            color: "#ffffff99"
      - id: "post1"
        name: "投稿 2"
        type: "frame"
        x: 0
        y: 720
        origin_x: 0
