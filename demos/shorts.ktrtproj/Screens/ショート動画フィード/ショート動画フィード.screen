variables:
  - kind: "normal"
    id: "page"
    name: "$page"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "more"
    name: "$more"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "user"
    name: "$user"
    value_type: "String"
    initial_value: "@aoi_dev"
  - kind: "normal"
    id: "caption"
    name: "$caption"
    value_type: "String"
    initial_value: "はじめての縦フィード。指で払って次へ"
  - kind: "normal"
    id: "music"
    name: "$music"
    value_type: "String"
    initial_value: "Neon Drift"
  - kind: "normal"
    id: "like_count"
    name: "$like_count"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "comment_count"
    name: "$comment_count"
    value_type: "Int"
    initial_value: "12"
  - kind: "normal"
    id: "avatar"
    name: "$avatar"
    value_type: "String"
    initial_value: "Images/avatar-1.png"
  - kind: "normal"
    id: "users"
    name: "$users"
    value_type: "Array"
    initial_value: "[\"@aoi_dev\",\"@katari_lab\",\"@mochi3d\",\"@night_run\",\"@pixel_kit\"]"
    element_type: "String"
  - kind: "normal"
    id: "captions"
    name: "$captions"
    value_type: "Array"
    initial_value: "[\"はじめての縦フィード。指で払って次へ\",\"図形だけで作った“映像”。素材は 0 枚\",\"いいねは投稿ごとに別で数える\",\"コメント欄は下から出るスクロール面\",\"ここが最後。末尾に来ると下に札が出る\"]"
    element_type: "String"
  - kind: "normal"
    id: "musics"
    name: "$musics"
    value_type: "Array"
    initial_value: "[\"Neon Drift\",\"Blue Hour\",\"Sugar Static\",\"Night Run\",\"Pixel Dawn\"]"
    element_type: "String"
  - kind: "normal"
    id: "comment_counts"
    name: "$comment_counts"
    value_type: "Array"
    initial_value: "[12,34,5,87,21]"
    element_type: "Int"
  - kind: "normal"
    id: "avatars"
    name: "$avatars"
    value_type: "Array"
    initial_value: "[\"Images/avatar-1.png\",\"Images/avatar-2.png\",\"Images/avatar-3.png\",\"Images/avatar-4.png\",\"Images/avatar-5.png\"]"
    element_type: "String"
  - kind: "normal"
    id: "likes"
    name: "$likes"
    value_type: "Array"
    initial_value: "[0,0,0,0,0]"
    element_type: "Int"
  - kind: "normal"
    id: "command"
    name: "$command"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "comments_open"
    name: "$comments_open"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "profile_open"
    name: "$profile_open"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "spin"
    name: "$spin"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "bounce"
    name: "$bounce"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "play0"
    name: "$play0"
    value_type: "Bool"
    initial_value: "true"
  - kind: "normal"
    id: "play1"
    name: "$play1"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
