variables:
  - kind: "normal"
    id: "page"
    name: "$page"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "more"
    name: "$more"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "user"
    name: "$user"
    value_type: "String"
    initial_value: "@aoi_dev"
  - kind: "normal"
    id: "caption"
    name: "$caption"
    value_type: "String"
    initial_value: "はじめての縦フィード。指で払って次へ"
  - kind: "normal"
    id: "music"
    name: "$music"
    value_type: "String"
    initial_value: "Neon Drift"
  - kind: "normal"
    id: "like_count"
    name: "$like_count"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "comment_count"
    name: "$comment_count"
    value_type: "Int"
    initial_value: "12"
  - kind: "normal"
    id: "avatar"
    name: "$avatar"
    value_type: "String"
    initial_value: "Images/avatar-1.png"
  - kind: "normal"
    id: "users"
    name: "$users"
    value_type: "Array"
    initial_value: "[\"@aoi_dev\",\"@katari_lab\",\"@mochi3d\",\"@night_run\",\"@pixel_kit\"]"
    element_type: "String"
  - kind: "normal"
    id: "captions"
    name: "$captions"
    value_type: "Array"
    initial_value: "[\"はじめての縦フィード。指で払って次へ\",\"図形だけで作った“映像”。素材は 0 枚\",\"いいねは投稿ごとに別で数える\",\"コメント欄は下から出るスクロール面\",\"ここが最後。末尾に来ると下に札が出る\"]"
    element_type: "String"
  - kind: "normal"
    id: "musics"
    name: "$musics"
    value_type: "Array"
    initial_value: "[\"Neon Drift\",\"Blue Hour\",\"Sugar Static\",\"Night Run\",\"Pixel Dawn\"]"
    element_type: "String"
  - kind: "normal"
    id: "comment_counts"
    name: "$comment_counts"
    value_type: "Array"
    initial_value: "[12,34,5,87,21]"
    element_type: "Int"
  - kind: "normal"
    id: "avatars"
    name: "$avatars"
    value_type: "Array"
    initial_value: "[\"Images/avatar-1.png\",\"Images/avatar-2.png\",\"Images/avatar-3.png\",\"Images/avatar-4.png\",\"Images/avatar-5.png\"]"
    element_type: "String"
  - kind: "normal"
    id: "likes"
    name: "$likes"
    value_type: "Array"
    initial_value: "[0,0,0,0,0]"
    element_type: "Int"
  - kind: "normal"
    id: "command"
    name: "$command"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "comments_open"
    name: "$comments_open"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "profile_open"
    name: "$profile_open"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "spin"
    name: "$spin"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "bounce"
    name: "$bounce"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "play0"
    name: "$play0"
    value_type: "Bool"
    initial_value: "true"
  - kind: "normal"
    id: "play1"
    name: "$play1"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "play2"
    name: "$play2"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "play3"
    name: "$play3"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "play4"
    name: "$play4"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "vpos"
    name: "$vpos"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "vdur"
    name: "$vdur"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "prog_w"
    name: "$prog_w"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "bounce_t"
    name: "$bounce_t"
    value_type: "Float"
    initial_value: "0"
requests: []
script: ".events.tick.subscribe\n\tspin = (spin + (dt * 90))\n\tbounce_t = ((bounce_t + dt) % 2)\n\tbounce = (430 + (60 * float_abs(a=(bounce_t - 1))))\n\tuser = array_get(users, page)\n\tcaption = array_get(captions, page)\n\tmusic = array_get(musics, page)\n\tlike_count = array_get(likes, page)\n\tcomment_count = array_get(comment_counts, page)\n\tavatar = array_get(avatars, page)\n\tplay0 = (page == 0)\n\tplay1 = (page == 1)\n\tplay2 = (page == 2)\n\tplay3 = (page == 3)\n\tplay4 = (page == 4)\n\tprog_w = (366 * (vpos / float_max(a=vdur, b=0.001)))\n\tif command == \"like\"\n\t\tlike_count += 1\n\t\tlikes = array_set(likes, page, like_count)\n\t\tcommand = \"\"\n\telif command == \"comments\"\n\t\tcomments_open = true\n\t\tcommand = \"\"\n\telif command == \"profile\"\n\t\tprofile_open = true\n\t\tcommand = \"\"\n\telif command == \"close\"\n\t\tcomments_open = false\n\t\tprofile_open = false\n\t\tcommand = \"\"\n"
