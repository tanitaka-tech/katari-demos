  - id: "overlay"
    name: "overlay"
    type: "frame"
    x: 437
    y: 0
    origin_x: 0
    origin_y: 0
    width: 406
    height: 720
    fill: "#00000000"
    children:
      - id: "ov_tabs"
        name: "ov_tabs"
        type: "text"
        x: 90
        y: 28
        origin_x: 0
        origin_y: 0
        width: 260
        height: 27
        text: "おすすめ　|　フォロー中"
        font_size: 17
        color: "#ffffffcc"
      - id: "ov_avatar"
        name: "ov_avatar"
        type: "image"
        texture: "$avatar"
        x: 20
        y: 486
        origin_x: 0
        origin_y: 0
        width: 56
        height: 56
      - id: "ov_user"
        name: "ov_user"
        type: "text"
        x: 20
        y: 560
        origin_x: 0
        origin_y: 0
        width: 280
        height: 35
        text: "{$user}"
        font_size: 22
        color: "#ffffff"
      - id: "ov_caption"
        name: "ov_caption"
        type: "text"
        x: 20
        y: 596
        origin_x: 0
        origin_y: 0
        width: 290
        height: 26
        text: "{$caption}"
        font_size: 16
        color: "#ffffffdd"
      - id: "ov_music"
        name: "ov_music"
        type: "text"
        x: 20
        y: 640
        origin_x: 0
        origin_y: 0
        width: 290
        height: 24
        text: "♪ {$music}"
        font_size: 15
        color: "#ffffffaa"
      - id: "btn_like"
        name: "btn_like"
        type: "button"
        x: 322
        y: 300
        origin_x: 0
        origin_y: 0
        width: 72
        height: 64
        text: "♥\n{$like_count}"
        font_size: 15
        fill: "#00000066"
        color: "#ffffff"
        corner_radius: 16
        events:
          - id: "btn_like_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "like"
      - id: "btn_comment"
        name: "btn_comment"
        type: "button"
        x: 322
        y: 376
        origin_x: 0
        origin_y: 0
        width: 72
        height: 64
        text: "コメント\n{$comment_count}"
        font_size: 15
        fill: "#00000066"
        color: "#ffffff"
        corner_radius: 16
        events:
          - id: "btn_comment_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "comments"
      - id: "btn_profile"
        name: "btn_profile"
        type: "button"
        x: 322
        y: 452
        origin_x: 0
        origin_y: 0
        width: 72
        height: 64
        text: "プロフ"
        font_size: 15
        fill: "#00000066"
        color: "#ffffff"
        corner_radius: 16
        events:
          - id: "btn_profile_ev"
            trigger: "click"
            action:
              kind: "set_variable"
              variable_id: "command"
              value: "profile"
      - id: "ov_progress_bg"
        name: "ov_progress_bg"
        type: "rectangle"
        x: 20
        y: 700
        origin_x: 0
        origin_y: 0
        width: 366
        height: 4
        fill: "#ffffff33"
        corner_radius: 2
      - id: "ov_progress"
        name: "ov_progress"
        type: "rectangle"
        x: 20
        y: 700
        origin_x: 0
        origin_y: 0
        width: "$prog_w"
        height: 4
        fill: "#ffffffcc"
        corner_radius: 2
      - id: "ov_end"
        name: "ov_end"
        type: "text"
        x: 20
        y: 508
        origin_x: 0
        origin_y: 0
        width: 260
        height: 24
        text: "これ以上ありません"
        font_size: 15
        color: "#ffffff99"
        visible: "$more"
  - id: "comments"
    name: "コメント欄"
    type: "frame"
    x: 437
    y: 320
    origin_x: 0
    origin_y: 0
    width: 406
    height: 400
    fill: "#12121a"
    corner_radius: 20
    visible: "$comments_open"
    children:
      - id: "cm_title"
        name: "cm_title"
        type: "text"
        x: 20
        y: 20
        origin_x: 0
        origin_y: 0
        width: 240
        height: 29
        text: "コメント {$comment_count} 件"
        font_size: 18
        color: "#ffffff"
      - id: "btn_comments_close"
        name: "閉じる"
