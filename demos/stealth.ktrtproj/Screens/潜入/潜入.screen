script: ".events.tick.subscribe dt_1 =>\n\tdt = dt_1\n\tmx = move.x\n\tmz = move.y\n\tmoving = mx * mx + mz * mz > 0.01\n\tspd = sneak ? 1.9 : 4.6\n\tnoise = moving ? sneak ? 2.5 : 12 : 0\n\tpvy = max(pvy - 18 * dt, -30)\n\tpx = space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(px, py, pz), 0.3, 1.8, (make_vec3((mx * spd * dt), (pvy * dt), (mz * spd * dt))), 0.3, 50, \"[\\\"player\\\"]\", \"position\").x\n\tpy = space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(px, py, pz), 0.3, 1.8, (make_vec3((mx * spd * dt), (pvy * dt), (mz * spd * dt))), 0.3, 50, \"[\\\"player\\\"]\", \"position\").y\n\tpz = space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(px, py, pz), 0.3, 1.8, (make_vec3((mx * spd * dt), (pvy * dt), (mz * spd * dt))), 0.3, 50, \"[\\\"player\\\"]\", \"position\").z\n\tpvy = (space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(px, py, pz), 0.3, 1.8, (make_vec3((mx * spd * dt), (pvy * dt), (mz * spd * dt))), 0.3, 50, \"[\\\"player\\\"]\", \"on_ground\") ? 0 : pvy)\n\tpry = (moving ? (float_atan2(y=(mx * -1), x=(mz * -1)) * 57.29577951308232) : pry)\n\tsee1 = (space_sensor_sees_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") ? 1 : 0)\n\thear1 = (space_sensor_hears_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\") ? 1 : 0)\n\tg1hunt = ((space_sensor_sees_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") || space_sensor_hears_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\")) ? 4 : max(g1hunt - dt, 0))\n\tg1sx = ((space_sensor_sees_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") || space_sensor_hears_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\")) ? px : g1sx)\n\tg1sz = ((space_sensor_sees_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") || space_sensor_hears_field(__space_sensors, \"g1\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\")) ? pz : g1sz)\n\tg1tx = ((g1hunt > 0) ? g1sx : -13 + g1wp * 26)\n\tg1tz = ((g1hunt > 0) ? g1sz : -1 + g1wp * -1)\n\tg1x = space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(g1x, 0, g1z), 0.35, 1.8, (make_vec3((vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").x - g1x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").z - g1z)))).x * (((g1hunt > 0) ? 3.6 : 2.2) * dt)), (-18 * dt * dt), (vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").x - g1x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").z - g1z)))).z * (((g1hunt > 0) ? 3.6 : 2.2) * dt)))), 0.3, 50, \"[\\\"g1\\\"]\", \"position\").x\n\tg1z = space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(g1x, 0, g1z), 0.35, 1.8, (make_vec3((vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").x - g1x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").z - g1z)))).x * (((g1hunt > 0) ? 3.6 : 2.2) * dt)), (-18 * dt * dt), (vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").x - g1x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").z - g1z)))).z * (((g1hunt > 0) ? 3.6 : 2.2) * dt)))), 0.3, 50, \"[\\\"g1\\\"]\", \"position\").z\n\tg1ry = ((g1hunt > 0) ? (float_atan2(y=g1x - g1sx, x=g1z - g1sz) * 57.29577951308232) : (space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"found\") ? (float_atan2(y=(vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").x - g1x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").z - g1z)))).x * -1), x=(vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").x - g1x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"next\").z - g1z)))).z * -1)) * 57.29577951308232) : g1ry))\n\tg1wp = ((space_nav_step_field(__space_colliders_solid, make_vec3(g1x, 0, g1z), make_vec3(g1tx, 0, g1tz), 1, 0.35, 1.8, 50, \"arrived\") && (!(g1hunt > 0))) ? 1 - g1wp : g1wp)\n\tsee2 = (space_sensor_sees_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") ? 1 : 0)\n\thear2 = (space_sensor_hears_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\") ? 1 : 0)\n\tg2hunt = ((space_sensor_sees_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") || space_sensor_hears_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\")) ? 4 : max(g2hunt - dt, 0))\n\tg2sx = ((space_sensor_sees_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") || space_sensor_hears_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\")) ? px : g2sx)\n\tg2sz = ((space_sensor_sees_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 1.4), pz)), \"[\\\"player\\\"]\", \"visible\") || space_sensor_hears_field(__space_sensors, \"g2\", __space_colliders_solid, (make_vec3(px, (py + 0.3), pz)), noise, 0.4, \"[\\\"player\\\"]\", \"audible\")) ? pz : g2sz)\n\tg2tx = ((g2hunt > 0) ? g2sx : -8 + g2wp * 20)\n\tg2tz = ((g2hunt > 0) ? g2sz : 10 + g2wp * -2)\n\tg2x = space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(g2x, 0, g2z), 0.35, 1.8, (make_vec3((vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").x - g2x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").z - g2z)))).x * (((g2hunt > 0) ? 3.6 : 2.2) * dt)), (-18 * dt * dt), (vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").x - g2x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").z - g2z)))).z * (((g2hunt > 0) ? 3.6 : 2.2) * dt)))), 0.3, 50, \"[\\\"g2\\\"]\", \"position\").x\n\tg2z = space_move_slide_field(array_concat(__space_colliders_solid, __space_colliders_actor), make_vec3(g2x, 0, g2z), 0.35, 1.8, (make_vec3((vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").x - g2x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").z - g2z)))).x * (((g2hunt > 0) ? 3.6 : 2.2) * dt)), (-18 * dt * dt), (vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").x - g2x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").z - g2z)))).z * (((g2hunt > 0) ? 3.6 : 2.2) * dt)))), 0.3, 50, \"[\\\"g2\\\"]\", \"position\").z\n\tg2ry = ((g2hunt > 0) ? (float_atan2(y=g2x - g2sx, x=g2z - g2sz) * 57.29577951308232) : (space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"found\") ? (float_atan2(y=(vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").x - g2x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").z - g2z)))).x * -1), x=(vec3_normalize((make_vec3((space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").x - g2x), 0, (space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"next\").z - g2z)))).z * -1)) * 57.29577951308232) : g2ry))\n\tg2wp = ((space_nav_step_field(__space_colliders_solid, make_vec3(g2x, 0, g2z), make_vec3(g2tx, 0, g2tz), 1, 0.35, 1.8, 50, \"arrived\") && (!(g2hunt > 0))) ? 1 - g2wp : g2wp)\n\tgain = (see1 + see2) * 80 + (hear1 + hear2) * 34 - 22\n\talert = clamp(alert + gain * dt, 0, 100)\n\tseen = see1 + see2 > 0\n\talert_w = alert * 4\n\tbusted = (alert >= 100)\n\tcaught = ((alert >= 10