screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "view"
    name: "施設"
    type: "screen-instance"
    screen_id: "screen_stealth_facility"
  - id: "alert_frame"
    name: "警戒メーターの枠"
    type: "rectangle"
    x: 40
    y: 36
    origin_x: 0
    origin_y: 0
    width: 404
    height: 20
    fill: "#00000088"
    z_index: 100
  - id: "alert_bar"
    name: "警戒メーター"
    type: "rectangle"
    x: 42
    y: 38
    origin_x: 0
    origin_y: 0
    width: "$alert_w"
    height: 16
    fill: "#e05a5a"
    z_index: 101
  - id: "status"
    name: "状態"
    type: "text"
    x: 40
    y: 64
    origin_x: 0
    origin_y: 0
    width: 700
    height: 30
    text: "$status"
    font_size: 22
    color: "#e8eef6"
    text_align: "left"
    z_index: 101
  - id: "hint"
    name: "操作"
    type: "text"
    x: 40
    y: 672
    origin_x: 0
    origin_y: 0
    width: 900
    height: 26
    text: "WASD で移動 / Space で忍び足（遅いが静か）"
    font_size: 18
    color: "#8fa0b4"
    text_align: "left"
    z_index: 101
