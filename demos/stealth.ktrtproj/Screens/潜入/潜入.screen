screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "view"
    name: "施設"
    type: "screen-instance"
    screen_id: "screen_stealth_facility"
  - id: "alert_frame"
    name: "警戒メーターの枠"
    type: "rectangle"
    x: 40
    y: 36
    origin_x: 0
    origin_y: 0
    width: 404
    height: 20
    fill: "#00000088"
    z_index: 100
  - id: "alert_bar"
    name: "警戒メーター"
    type: "rectangle"
    x: 42
    y: 38
    origin_x: 0
    origin_y: 0
    width: "$alert_w"
    height: 16
    fill: "#e05a5a"
    z_index: 101
  - id: "status"
    name: "状態"
    type: "text"
    x: 40
    y: 64
    origin_x: 0
    origin_y: 0
    width: 700
    height: 30
    text: "$status"
    font_size: 22
    color: "#e8eef6"
    text_align: "left"
    z_index: 101
  - id: "hint"
    name: "操作"
    type: "text"
    x: 40
    y: 672
    origin_x: 0
    origin_y: 0
    width: 900
    height: 26
    text: "WASD で移動 / Space で忍び足（遅いが静か）"
    font_size: 18
    color: "#8fa0b4"
    text_align: "left"
    z_index: 101
variables:
  - kind: "normal"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "pz"
    name: "$pz"
    value_type: "Float"
    initial_value: "-12"
  - kind: "normal"
    id: "pvy"
    name: "$pvy"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "pry"
    name: "$pry"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "move"
    name: "$move"
    value_type: "Vector2"
    initial_value: "0,0"
  - kind: "normal"
    id: "sneak"
    name: "$sneak"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "mx"
    name: "$mx"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "mz"
    name: "$mz"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "spd"
    name: "$spd"
    value_type: "Float"
    initial_value: "4.6"
  - kind: "normal"
    id: "dt"
    name: "$dt"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "noise"
    name: "$noise"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "moving"
    name: "$moving"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "alert"
    name: "$alert"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "alert_w"
    name: "$alert_w"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "see1"
    name: "$see1"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "see2"
