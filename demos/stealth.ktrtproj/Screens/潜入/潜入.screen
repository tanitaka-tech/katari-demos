    name: "$gain"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "seen"
    name: "$seen"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "busted"
    name: "$busted"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "caught"
    name: "$caught"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "cleared"
    name: "$cleared"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "status"
    name: "$status"
    value_type: "String"
    initial_value: "出口をめざせ"
  - kind: "normal"
    id: "g1x"
    name: "$g1x"
    value_type: "Float"
    initial_value: "-13"
  - kind: "normal"
    id: "g1z"
    name: "$g1z"
    value_type: "Float"
    initial_value: "-1"
  - kind: "normal"
    id: "g1ry"
    name: "$g1ry"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g1wp"
    name: "$g1wp"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g1hunt"
    name: "$g1hunt"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g1sx"
    name: "$g1sx"
    value_type: "Float"
    initial_value: "-13"
  - kind: "normal"
    id: "g1sz"
    name: "$g1sz"
    value_type: "Float"
    initial_value: "-1"
  - kind: "normal"
    id: "g1tx"
    name: "$g1tx"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g1tz"
    name: "$g1tz"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g2x"
    name: "$g2x"
    value_type: "Float"
    initial_value: "-8"
  - kind: "normal"
    id: "g2z"
    name: "$g2z"
    value_type: "Float"
    initial_value: "10"
  - kind: "normal"
    id: "g2ry"
    name: "$g2ry"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g2wp"
    name: "$g2wp"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g2hunt"
    name: "$g2hunt"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g2sx"
    name: "$g2sx"
    value_type: "Float"
    initial_value: "-8"
  - kind: "normal"
    id: "g2sz"
    name: "$g2sz"
    value_type: "Float"
    initial_value: "10"
  - kind: "normal"
    id: "g2tx"
    name: "$g2tx"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "g2tz"
    name: "$g2tz"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "crates"
    name: "$crates"
    value_type: "Array"
    initial_value: "[\"{\\\"id\\\":\\\"c1\\\",\\\"x\\\":-6,\\\"z\\\":-10}\",\"{\\\"id\\\":\\\"c2\\\",\\\"x\\\":6,\\\"z\\\":-9.5}\",\"{\\\"id\\\":\\\"c3\\\",\\\"x\\\":-3,\\\"z\\\":-2}\",\"{\\\"id\\\":\\\"c4\\\",\\\"x\\\":3.5,\\\"z\\\":1}\",\"{\\\"id\\\":\\\"c5\\\",\\\"x\\\":10,\\\"z\\\":-1.5}\",\"{\\\"id\\\":\\\"c6\\\",\\\"x\\\":-9,\\\"z\\\":1.5}\",\"{\\\"id\\\":\\\"c7\\\",\\\"x\\\":9,\\\"z\\\":9}\",\"{\\\"id\\\":\\\"c8\\\",\\\"x\\\":1,\\\"z\\\":11}\"]"
    element_type: "String"
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_tick"
    - id: "get_input_action_vector2_1"
      type: "get_input_action_vector2"
      properties:
        actionMap: "map_gameplay"
        action: "act_move"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Vector2\"]"
      next: "set_variable_1"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "move"
    - id: "subscribe_vector2_1"
      type: "subscribe_vector2"
      next: "subscribe_bool_1"
    - id: "get_input_action_bool_1"
      type: "get_input_action_bool"
      properties:
        actionMap: "map_gameplay"
        action: "act_sneak"
    - id: "lambda_2"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Bool\"]"
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "sneak"
    - id: "subscribe_bool_1"
      type: "subscribe_bool"
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "dt"
      next: "set_variable_4"
    - id: "break_vector2_1"
      type: "break_vector2"
      properties:
        v: "$move"
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "mx"
      next: "set_variable_5"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "mz"
      next: "set_variable_6"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
        variable: "moving"
        value: "=$mx * $mx + $mz * $mz > 0.01"
      next: "set_variable_7"
    - id: "ternary_1"
      type: "ternary"
      properties:
        index: "$sneak"
        true: 1.9
        false: 4.6
    - id: "set_variable_7"
      type: "set_variable"
      properties:
        variable: "spd"
      next: "set_variable_8"
    - id: "ternary_2"
      type: "ternary"
      properties:
        index: "$sneak"
        true: 2.5
        false: 12
    - id: "ternary_3"
      type: "ternary"
      properties:
        index: "$moving"
        false: 0
    - id: "set_variable_8"
      type: "set_variable"
      properties:
        variable: "noise"
      next: "set_variable_9"
    - id: "set_variable_9"
      type: "set_variable"
      properties:
        variable: "pvy"
        value: "=max($pvy - 18 * $dt, -30)"
      next: "set_variable_10"
    - id: "get_space_colliders_1"
      type: "get_space_colliders"
      properties:
        layer: "solid"
    - id: "get_space_colliders_2"
      type: "get_space_colliders"
      properties:
        layer: "actor"
    - id: "array_concat_1"
      type: "array_concat"
    - id: "make_vector3_1"
      type: "make_vector3"
      properties:
        x: "$px"
        y: "$py"
        z: "$pz"
    - id: "make_vector3_2"
      type: "make_vector3"
      properties:
        x: "=$mx * $spd * $dt"
        y: "=$pvy * $dt"
        z: "=$mz * $spd * $dt"
    - id: "move_and_slide_3d_1"
      type: "move_and_slide_3d"
      properties:
        radius: 0.3
        height: 1.8
        ignore_ids: "[\"player\"]"
    - id: "break_vector3_1"
      type: "break_vector3"
    - id: "set_variable_10"
      type: "set_variable"
      properties:
        variable: "px"
      next: "set_variable_11"
    - id: "set_variable_11"
      type: "set_variable"
      properties:
        variable: "py"
      next: "set_variable_12"
    - id: "set_variable_12"
      type: "set_variable"
      properties:
        variable: "pz"
      next: "set_variable_13"
    - id: "ternary_4"
      type: "ternary"
      properties:
        true: 0
        false: "$pvy"
    - id: "set_variable_13"
      type: "set_variable"
      properties:
        variable: "pvy"
      next: "set_variable_14"
    - id: "float_mul_1"
      type: "float_mul"
      properties:
        a: "$mx"
        b: -1
    - id: "float_mul_2"
      type: "float_mul"
      properties:
        a: "$mz"
        b: -1
    - id: "float_atan2_1"
      type: "float_atan2"
    - id: "float_mul_3"
      type: "float_mul"
      properties:
        b: 57.29577951308232
    - id: "ternary_5"
      type: "ternary"
      properties:
        index: "$moving"
        false: "$pry"
    - id: "set_variable_14"
      type: "set_variable"
      properties:
        variable: "pry"
      next: "set_variable_15"
    - id: "get_space_sensors_1"
      type: "get_space_sensors"
    - id: "get_space_colliders_3"
      type: "get_space_colliders"
      properties:
        layer: "solid"
    - id: "make_vector3_3"
      type: "make_vector3"
      properties:
        x: "$g1x"
        y: 0
        z: "$g1z"
    - id: "make_vector3_4"
      type: "make_vector3"
      properties:
        x: "$px"
        y: "=$py + 1.4"
        z: "$pz"
    - id: "sensor_sees_3d_1"
      type: "sensor_sees_3d"
      properties:
        sensor_id: "g1"
        ignore_ids: "[\"player\"]"
    - id: "make_vector3_5"
      type: "make_vector3"
      properties:
        x: "$px"
        y: "=$py + 0.3"
        z: "$pz"
    - id: "sensor_hears_3d_1"
      type: "sensor_hears_3d"
      properties:
        sensor_id: "g1"
        loudness: "$noise"
        ignore_ids: "[\"player\"]"
    - id: "or_op_1"
      type: "or_op"
    - id: "ternary_6"
      type: "ternary"
      properties:
        true: 1
        false: 0
    - id: "set_variable_15"
      type: "set_variable"
      properties:
        variable: "see1"
      next: "set_variable_16"
    - id: "ternary_7"
      type: "ternary"
      properties:
        true: 1
        false: 0
    - id: "set_variable_16"
      type: "set_variable"
      properties:
        variable: "hear1"
      next: "set_variable_17"
    - id: "ternary_8"
      type: "ternary"
      properties:
        true: 4
        false: "=max($g1hunt - $dt, 0)"
    - id: "set_variable_17"
      type: "set_variable"
      properties:
        variable: "g1hunt"
      next: "set_variable_18"
    - id: "ternary_9"
      type: "ternary"
      properties:
        true: "$px"
        false: "$g1sx"
    - id: "set_variable_18"
      type: "set_variable"
      properties:
        variable: "g1sx"
      next: "set_variable_19"
    - id: "ternary_10"
      type: "ternary"
      properties:
        true: "$pz"
        false: "$g1sz"
    - id: "set_variable_19"
      type: "set_variable"
      properties:
        variable: "g1sz"
      next: "set_variable_20"
    - id: "float_gt_1"
      type: "float_gt"
      properties:
        a: "$g1hunt"
        b: 0
    - id: "ternary_11"
      type: "ternary"
      properties:
        true: "$g1sx"
        false: "=-13 + $g1wp * 26"
    - id: "set_variable_20"
      type: "set_variable"
      properties:
        variable: "g1tx"
      next: "set_variable_21"
    - id: "ternary_12"
      type: "ternary"
      properties:
        true: "$g1sz"
        false: "=-1 + $g1wp * -1"
    - id: "set_variable_21"
      type: "set_variable"
      properties:
        variable: "g1tz"
      next: "set_variable_22"
    - id: "make_vector3_6"
      type: "make_vector3"
      properties:
        x: "$g1tx"
        y: 0
        z: "$g1tz"
    - id: "nav_next_step_3d_1"
      type: "nav_next_step_3d"
      properties:
        cell: 1
        agent_radius: 0.35
        agent_height: 1.8
    - id: "break_vector3_2"
      type: "break_vector3"
    - id: "float_sub_1"
      type: "float_sub"
      properties:
        b: "$g1x"
    - id: "float_sub_2"
      type: "float_sub"
      properties:
        b: "$g1z"
    - id: "make_vector3_7"
      type: "make_vector3"
      properties:
        y: 0
    - id: "vector3_normalize_1"
      type: "vector3_normalize"
    - id: "break_vector3_3"
      type: "break_vector3"
    - id: "ternary_13"
      type: "ternary"
      properties:
        true: 3.6
        false: 2.2
    - id: "get_space_colliders_4"
      type: "get_space_colliders"
      properties:
        layer: "actor"
    - id: "array_concat_2"
      type: "array_concat"
    - id: "float_mul_4"
      type: "float_mul"
      properties:
        b: "$dt"
    - id: "float_mul_5"
      type: "float_mul"
    - id: "float_mul_6"
      type: "float_mul"
      properties:
        b: "$dt"
    - id: "float_mul_7"
      type: "float_mul"
    - id: "make_vector3_8"
      type: "make_vector3"
      properties:
        y: "=-18 * $dt * $dt"
    - id: "move_and_slide_3d_2"
      type: "move_and_slide_3d"
      properties:
        radius: 0.35
        height: 1.8
        ignore_ids: "[\"g1\"]"
    - id: "break_vector3_4"
      type: "break_vector3"
    - id: "set_variable_22"
      type: "set_variable"
      properties:
        variable: "g1x"
      next: "set_variable_23"
    - id: "set_variable_23"
      type: "set_variable"
      properties:
        variable: "g1z"
      next: "set_variable_24"
    - id: "float_atan2_2"
      type: "float_atan2"
      properties:
        y: "=$g1x - $g1sx"
        x: "=$g1z - $g1sz"
    - id: "float_mul_8"
      type: "float_mul"
      properties:
        b: 57.29577951308232
    - id: "float_mul_9"
      type: "float_mul"
      properties:
        b: -1
    - id: "float_mul_10"
      type: "float_mul"
      properties:
        b: -1
    - id: "float_atan2_3"
      type: "float_atan2"
    - id: "float_mul_11"
      type: "float_mul"
      properties:
        b: 57.29577951308232
    - id: "ternary_14"
      type: "ternary"
      properties:
        false: "$g1ry"
    - id: "ternary_15"
      type: "ternary"
    - id: "set_variable_24"
      type: "set_variable"
      properties:
        variable: "g1ry"
      next: "set_variable_25"
    - id: "not_op_1"
      type: "not_op"
    - id: "and_op_1"
      type: "and_op"
    - id: "ternary_16"
      type: "ternary"
      properties:
        true: "=1 - $g1wp"
        false: "$g1wp"
    - id: "set_variable_25"
      type: "set_variable"
      properties:
        variable: "g1wp"
      next: "set_variable_26"
    - id: "get_space_sensors_2"
      type: "get_space_sensors"
    - id: "get_space_colliders_5"
      type: "get_space_colliders"
      properties:
        layer: "solid"
    - id: "make_vector3_9"
      type: "make_vector3"
      properties:
        x: "$g2x"
        y: 0
        z: "$g2z"
    - id: "make_vector3_10"
      type: "make_vector3"
      properties:
        x: "$px"
        y: "=$py + 1.4"
        z: "$pz"
    - id: "sensor_sees_3d_2"
      type: "sensor_sees_3d"
      properties:
        sensor_id: "g2"
        ignore_ids: "[\"player\"]"
    - id: "make_vector3_11"
      type: "make_vector3"
      properties:
        x: "$px"
        y: "=$py + 0.3"
        z: "$pz"
    - id: "sensor_hears_3d_2"
      type: "sensor_hears_3d"
      properties:
        sensor_id: "g2"
        loudness: "$noise"
        ignore_ids: "[\"player\"]"
    - id: "or_op_2"
      type: "or_op"
    - id: "ternary_17"
      type: "ternary"
      properties:
        true: 1
        false: 0
    - id: "set_variable_26"
      type: "set_variable"
      properties:
        variable: "see2"
      next: "set_variable_27"
    - id: "ternary_18"
      type: "ternary"
      properties:
