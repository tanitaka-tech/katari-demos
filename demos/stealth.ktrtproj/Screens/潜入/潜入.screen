        false: 0
    - id: "set_variable_27"
      type: "set_variable"
      properties:
        variable: "hear2"
      next: "set_variable_28"
    - id: "ternary_19"
      type: "ternary"
      properties:
        true: 4
        false: "=max($g2hunt - $dt, 0)"
    - id: "set_variable_28"
      type: "set_variable"
