      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 40
        y: 3
        z: 0.5
      shape: "box"
      color: "#8d99ab"
      physics:
        body: "static"
        collider:
          shape: "box"
          half_extents:
            x: 0.5
            y: 0.5
            z: 0.5
