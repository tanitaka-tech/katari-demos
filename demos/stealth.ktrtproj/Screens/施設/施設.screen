screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables: []
requests: []
space:
  entities:
    - id: "floor"
      name: "床"
      type: "render"
      position:
        x: 0
        y: -0.25
        z: 0
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 40
        y: 0.5
        z: 30
      shape: "box"
      color: "#5b6472"
      physics:
        body: "static"
        collider:
          shape: "box"
          half_extents:
            x: 0.5
            y: 0.5
            z: 0.5
    - id: "wall_n"
      name: "wall_n"
      type: "render"
      position:
        x: 0
        y: 1.5
        z: -15
      rotation:
        x: 0
        y: 0
        z: 0
      scale:
        x: 40
        y: 3
        z: 0.5
      shape: "box"
      color: "#8d99ab"
      physics:
        body: "static"
        collider:
          shape: "box"
          half_extents:
            x: 0.5
            y: 0.5
            z: 0.5
    - id: "wall_s"
