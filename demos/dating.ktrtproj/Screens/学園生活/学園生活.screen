screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "bg"
    name: "bg"
    type: "rectangle"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    fill: "#101826"
  - id: "title"
    name: "タイトル"
    type: "text"
    x: 48
    y: 36
    origin_x: 0
    origin_y: 0
    width: 900
    height: 44
    text: "恋愛シミュレーション デモ"
    font_size: 32
    color: "#ffd166"
  - id: "panel_status"
    name: "panel_status"
    type: "rectangle"
    x: 40
    y: 96
    origin_x: 0
    origin_y: 0
    width: 560
    height: 300
    fill: "#16233a"
    corner_radius: 14
  - id: "val_week"
    name: "val_week"
    type: "text"
    x: 72
    y: 120
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "{$week} 週目 / 8"
    font_size: 24
    color: "#ffd166"
  - id: "val_study"
    name: "val_study"
    type: "text"
    x: 72
    y: 168
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "学力  {$study}"
    font_size: 24
    color: "#f4f7fb"
  - id: "val_sports"
    name: "val_sports"
    type: "text"
    x: 72
    y: 208
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "運動  {$sports}"
    font_size: 24
    color: "#f4f7fb"
  - id: "val_charm"
    name: "val_charm"
    type: "text"
    x: 72
    y: 248
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "魅力  {$charm}"
    font_size: 24
    color: "#f4f7fb"
  - id: "val_stamina"
    name: "val_stamina"
    type: "text"
    x: 72
    y: 288
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "体力  {$stamina}"
    font_size: 24
    color: "#f4f7fb"
  - id: "val_love"
    name: "val_love"
    type: "text"
    x: 72
    y: 336
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "好感度  {$love}"
    font_size: 24
    color: "#ff8fb1"
  - id: "panel_log"
    name: "panel_log"
    type: "rectangle"
    x: 640
    y: 96
    origin_x: 0
    origin_y: 0
    width: 600
    height: 300
    fill: "#16233a"
    corner_radius: 14
  - id: "val_log"
    name: "val_log"
    type: "text"
    x: 672
    y: 120
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "{$log}"
    font_size: 24
    color: "#cfe2ff"
  - id: "val_event"
    name: "val_event"
    type: "text"
    x: 672
    y: 336
    origin_x: 0
    origin_y: 0
    width: 420
    height: 32
    text: "今週の出来事: {$event}"
    font_size: 24
    color: "#8fb4ff"
  - id: "btn_study"
    name: "勉強する"
    type: "button"
    x: 48
    y: 470
    origin_x: 0
    origin_y: 0
    width: 224
    height: 68
    text: "勉強する"
    font_size: 22
    fill: "#3f6ea5"
    color: "#ffffff"
    corner_radius: 12
    visible: "=$__line_message == \"\""
    events:
      - id: "btn_study_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "command"
          value: "study"
  - id: "btn_sports"
    name: "運動する"
    type: "button"
    x: 296
    y: 470
    origin_x: 0
    origin_y: 0
    width: 224
    height: 68
    text: "運動する"
    font_size: 22
    fill: "#3f6ea5"
    color: "#ffffff"
    corner_radius: 12
    visible: "=$__line_message == \"\""
    events:
      - id: "btn_sports_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "command"
          value: "sports"
  - id: "btn_charm"
    name: "身だしなみ"
    type: "button"
    x: 544
    y: 470
    origin_x: 0
    origin_y: 0
    width: 224
    height: 68
    text: "身だしなみ"
    font_size: 22
    fill: "#3f6ea5"
    color: "#ffffff"
    corner_radius: 12
    visible: "=$__line_message == \"\""
    events:
      - id: "btn_charm_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "command"
          value: "charm"
  - id: "btn_meet"
    name: "会いに行く"
    type: "button"
    x: 792
    y: 470
    origin_x: 0
    origin_y: 0
    width: 224
    height: 68
    text: "会いに行く"
    font_size: 22
    fill: "#3f6ea5"
    color: "#ffffff"
    corner_radius: 12
    visible: "=$__line_message == \"\""
    events:
      - id: "btn_meet_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "command"
          value: "meet"
  - id: "btn_next_week"
    name: "週を進める"
    type: "button"
    x: 1040
    y: 470
    origin_x: 0
    origin_y: 0
    width: 192
    height: 68
    text: "週を進める"
    font_size: 22
    fill: "#c25a7a"
    color: "#ffffff"
    corner_radius: 12
    visible: "=$__line_message == \"\""
    events:
      - id: "btn_next_week_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "command"
          value: "advance"
  - id: "msg_box"
    name: "msg_box"
    type: "rectangle"
    x: 40
    y: 560
    origin_x: 0
    origin_y: 0
    width: 1200
    height: 128
    fill: "#0b1220"
    corner_radius: 14
    visible: "=$__line_message != \"\""
  - id: "msg_speaker"
    name: "話者"
    type: "text"
    x: 72
    y: 578
    origin_x: 0
    origin_y: 0
    width: 400
    height: 28
    text: "$__line_speaker"
    font_size: 20
    color: "#ffd166"
    visible: "=$__line_message != \"\""
  - id: "msg_text"
    name: "本文"
    type: "text"
    x: 72
    y: 612
    origin_x: 0
    origin_y: 0
    width: 1140
    height: 60
    text: "$__line_message"
    font_size: 24
    color: "#f4f7fb"
    reveal: "$__line_reveal"
    visible: "=$__line_message != \"\""
  - id: "btn_line_next"
    name: "btn_line_next"
    type: "button"
    x: 760
    y: 500
    origin_x: 0
    origin_y: 0
    width: 480
    height: 52
    text: "▼ 次へ"
    font_size: 22
    fill: "#2b3f5c"
    color: "#ffffff"
    corner_radius: 10
    visible: "=$__line_message != \"\" && !$__line_is_choice"
    events:
      - id: "btn_line_next_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "pick"
          value: "-1"
  - id: "btn_choice_1"
    name: "btn_choice_1"
    type: "button"
    x: 400
    y: 420
    origin_x: 0
    origin_y: 0
    width: 480
    height: 52
    text: "$__line_choice_1"
    font_size: 22
    fill: "#2b3f5c"
    color: "#ffffff"
    corner_radius: 10
    visible: "$__line_is_choice"
    events:
      - id: "btn_choice_1_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "pick"
          value: "1"
  - id: "btn_choice_2"
    name: "btn_choice_2"
    type: "button"
    x: 400
    y: 480
    origin_x: 0
    origin_y: 0
    width: 480
    height: 52
    text: "$__line_choice_2"
    font_size: 22
    fill: "#2b3f5c"
    color: "#ffffff"
    corner_radius: 10
    visible: "$__line_is_choice"
    events:
      - id: "btn_choice_2_ev"
        trigger: "click"
        action:
          kind: "set_variable"
          variable_id: "pick"
          value: "2"
variables:
  - kind: "normal"
    id: "week"
    name: "$week"
    value_type: "Int"
    initial_value: "1"
  - kind: "normal"
    id: "study"
    name: "$study"
    value_type: "Int"
    initial_value: "10"
  - kind: "normal"
    id: "sports"
    name: "$sports"
    value_type: "Int"
    initial_value: "10"
  - kind: "normal"
    id: "charm"
    name: "$charm"
    value_type: "Int"
    initial_value: "10"
  - kind: "normal"
    id: "stamina"
    name: "$stamina"
    value_type: "Int"
    initial_value: "100"
  - kind: "normal"
    id: "love"
    name: "$love"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "mood"
    name: "$mood"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "met"
    name: "$met"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "command"
    name: "$command"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "log"
    name: "$log"
    value_type: "String"
    initial_value: "何をする？"
  - kind: "normal"
    id: "event"
    name: "$event"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "phase"
    name: "$phase"
    value_type: "String"
    initial_value: "plan"
  - kind: "normal"
    id: "pick"
    name: "$pick"
    value_type: "Int"
    initial_value: "0"
  - kind: "normal"
    id: "ending"
    name: "$ending"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "events"
    name: "$events"
    value_type: "Array"
    initial_value: "[{\"id\":\"告白\",\"when\":\"$love >= 60 && $week >= 8\",\"priority\":100},{\"id\":\"すれ違い\",\"when\":\"$mood >= 3\",\"priority\":80},{\"id\":\"デート\",\"when\":\"$love >= 25\",\"priority\":50},{\"id\":\"廊下\",\"when\":\"\",\"priority\":1}]"
    element_type: "Struct"
requests: []
script_graph:
  nodes:
    - id: "set_random_seed_1"
      type: "set_random_seed"
      properties:
        seed: "dating-demo-2026"
      next: "set_script_variable_1"
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_tick"
    - id: "set_script_variable_1"
      type: "set_script_variable"
      properties:
        name: "__text_speed"
        value: "30"
    - id: "script_playing_1"
      type: "script_playing"
    - id: "string_length_1"
      type: "string_length"
      properties:
        text: "$__line_message"
    - id: "int_gt_1"
      type: "int_gt"
      properties:
        b: 0
    - id: "and_op_1"
      type: "and_op"
    - id: "branch_1"
      type: "branch"
      next:
        true: "set_variable_1"
        false: "switch_on_string_1"
    - id: "int_ne_1"
      type: "int_ne"
      properties:
        a: "$pick"
        b: 0
    - id: "branch_2"
      type: "branch"
      next:
        true: "advance_line_1"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "phase"
        value: "story"
      next: "branch_2"
    - id: "int_lt_1"
      type: "int_lt"
      properties:
        a: "$pick"
        b: 0
    - id: "ternary_1"
      type: "ternary"
      properties:
        true: 0
        false: "$pick"
    - id: "advance_line_1"
      type: "advance_line"
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "pick"
        value: 0
    - id: "switch_on_string_1"
      type: "switch_on_string"
      properties:
        selection: "$phase"
        case_count: 1
        case_0_value: "plan"
      next:
        default: "set_variable_3"
        case_0: "switch_on_string_2"
    - id: "script_variable_1"
      type: "script_variable"
      properties:
        name: "love"
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "love"
      next: "set_variable_4"
    - id: "script_variable_2"
      type: "script_variable"
      properties:
        name: "mood"
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "mood"
      next: "set_variable_5"
    - id: "script_variable_3"
      type: "script_variable"
      properties:
        name: "ending"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "ending"
      next: "set_variable_6"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
        variable: "phase"
        value: "plan"
      next: "set_variable_7"
    - id: "set_variable_7"
      type: "set_variable"
      properties:
        variable: "log"
        value: "何をする？"
    - id: "switch_on_string_2"
      type: "switch_on_string"
      properties:
        selection: "$command"
        case_count: 1
        case_0_value: "advance"
      next:
        default: "switch_on_string_3"
        case_0: "set_variable_34"
    - id: "switch_on_string_3"
      type: "switch_on_string"
      properties:
        selection: "$command"
        case_count: 4
        case_0_value: "study"
        case_1_value: "sports"
        case_2_value: "charm"
        case_3_value: "meet"
      next:
        case_0: "branch_3"
        case_1: "branch_4"
        case_2: "branch_5"
        case_3: "set_variable_29"
    - id: "int_ge_1"
      type: "int_ge"
      properties:
        a: "$stamina"
        b: 18
    - id: "branch_3"
      type: "branch"
      next:
        true: "set_variable_8"
        false: "set_variable_12"
    - id: "int_add_1"
      type: "int_add"
      properties:
        a: "$study"
        b: 6
    - id: "set_variable_8"
      type: "set_variable"
      properties:
        variable: "study"
      next: "set_variable_9"
    - id: "int_sub_1"
      type: "int_sub"
      properties:
        a: "$stamina"
        b: 18
    - id: "set_variable_9"
