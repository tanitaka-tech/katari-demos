  - id: "fence"
    name: "低い柵"
    type: "rectangle"
    x: 448
    y: 192
    origin_x: 0
    origin_y: 0
    width: 32
    height: 320
    fill: "#8a6a3a"
    z_index: 192
    collider:
      wall_height: 24
      layer: "solid"
  - id: "rock"
    name: "岩"
    type: "rectangle"
    x: 896
    y: 288
    origin_x: 0
    origin_y: 0
    width: 64
    height: 64
    fill: "#7a7a82"
    z_index: 352
    collider:
      layer: "block"
  - id: "tree_a"
    name: "木 a"
    type: "rectangle"
    x: 192
    y: 256
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#2f5d3a"
    z_index: 320
    collider:
      offset_y: 44.8
      height: 19.2
      layer: "solid"
  - id: "tree_b"
    name: "木 b"
    type: "rectangle"
    x: 800
    y: 160
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#2f5d3a"
    z_index: 224
    collider:
      offset_y: 44.8
      height: 19.2
      layer: "solid"
  - id: "tree_c"
    name: "木 c"
    type: "rectangle"
    x: 1056
    y: 448
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#2f5d3a"
    z_index: 512
    collider:
      offset_y: 44.8
      height: 19.2
      layer: "solid"
  - id: "player"
    name: "プレイヤー"
    type: "image"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 28
    fallback_color: "#ff6b4a"
    z_index: "=$py + 28"
    elevation: "$lift"
  - id: "shadow"
    name: "影"
    type: "rectangle"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 28
    fill: "#22331f"
    alpha: 0.35
    corner_radius: 12
    z_index: "=$py + 28"
  - id: "enemy"
    name: "追ってくるもの"
    type: "image"
    x: "$ex"
    y: "$ey"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 24
    fallback_color: "#d8425f"
    z_index: "=$ey + 24"
  - id: "camera"
    name: "カメラ"
    type: "camera"
    x: 640
    y: 352
    width: 1280
    height: 720
variables:
  - kind: "normal"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "96"
  - kind: "normal"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "320"
  - kind: "normal"
    id: "lift"
    name: "$lift"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "jump_t"
    name: "$jump_t"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "ex"
    name: "$ex"
    value_type: "Float"
    initial_value: "1120"
  - kind: "normal"
    id: "ey"
    name: "$ey"
    value_type: "Float"
    initial_value: "320"
  - kind: "normal"
    id: "move"
    name: "$move"
    value_type: "Vector2"
    initial_value: "0,0"
  - kind: "normal"
    id: "jump"
    name: "$jump"
    value_type: "Bool"
    initial_value: "false"
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_1"
    - id: "get_input_action_vector2_1"
      type: "get_input_action_vector2"
      properties:
        actionMap: "map_gameplay"
        action: "act_move"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Vector2\"]"
      next: "set_variable_1"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "move"
    - id: "subscribe_1"
      type: "subscribe"
      next: "subscribe_2"
    - id: "get_input_action_bool_1"
      type: "get_input_action_bool"
      properties:
        actionMap: "map_gameplay"
        action: "act_jump"
    - id: "lambda_2"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Bool\"]"
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "jump"
    - id: "subscribe_2"
      type: "subscribe"
      next: "subscribe_3"
    - id: "lambda_3"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Float\"]"
      next: "set_variable_3"
    - id: "on_tick_1"
      type: "on_tick"
    - id: "subscribe_3"
