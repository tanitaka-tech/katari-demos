  - id: "fence"
    name: "低い柵"
    type: "rectangle"
    x: 448
    y: 192
    origin_x: 0
    origin_y: 0
    width: 32
    height: 320
    fill: "#8a6a3a"
    z_index: 192
    collider:
      wall_height: 24
      layer: "solid"
  - id: "rock"
    name: "岩"
    type: "rectangle"
    x: 896
    y: 288
    origin_x: 0
    origin_y: 0
    width: 64
    height: 64
    fill: "#7a7a82"
    z_index: 352
    collider:
      layer: "block"
  - id: "tree_a"
    name: "木 a"
    type: "rectangle"
    x: 192
    y: 256
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#2f5d3a"
    z_index: 320
    collider:
      offset_y: 44.8
      height: 19.2
      layer: "solid"
  - id: "tree_b"
    name: "木 b"
    type: "rectangle"
    x: 800
    y: 160
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#2f5d3a"
    z_index: 224
    collider:
      offset_y: 44.8
      height: 19.2
      layer: "solid"
  - id: "tree_c"
    name: "木 c"
    type: "rectangle"
    x: 1056
    y: 448
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#2f5d3a"
    z_index: 512
    collider:
      offset_y: 44.8
      height: 19.2
      layer: "solid"
  - id: "player"
    name: "プレイヤー"
    type: "image"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 28
    fallback_color: "#ff6b4a"
    z_index: "=$py + 28"
    elevation: "$lift"
  - id: "shadow"
    name: "影"
    type: "rectangle"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 28
    fill: "#22331f"
    alpha: 0.35
    corner_radius: 12
    z_index: "=$py + 28"
  - id: "enemy"
    name: "追ってくるもの"
    type: "image"
    x: "$ex"
    y: "$ey"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 24
    fallback_color: "#d8425f"
    z_index: "=$ey + 24"
  - id: "camera"
    name: "カメラ"
    type: "camera"
    x: 640
    y: 352
    width: 1280
    height: 720
variables:
  - kind: "normal"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "96"
  - kind: "normal"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "320"
  - kind: "normal"
    id: "lift"
    name: "$lift"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "jump_t"
    name: "$jump_t"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "ex"
    name: "$ex"
    value_type: "Float"
    initial_value: "1120"
  - kind: "normal"
    id: "ey"
    name: "$ey"
    value_type: "Float"
    initial_value: "320"
  - kind: "normal"
    id: "move"
    name: "$move"
    value_type: "Vector2"
    initial_value: "0,0"
  - kind: "normal"
    id: "jump"
    name: "$jump"
    value_type: "Bool"
    initial_value: "false"
requests: []
script: ".input.map_gameplay.act_move.subscribe v_1 =>\n\tmove = v_1\n.input.map_gameplay.act_jump.subscribe v_2 =>\n\tjump = v_2\n.events.tick.subscribe\n\tjump_t = ((jump && float_nearly_zero(a=jump_t, tol=0.0001)) ? 0.6 : float_max(a=(jump_t - dt), b=0))\n\tlift = (float_nearly_zero(a=jump_t, tol=0.0001) ? 0 : ((192 * (1 - (jump_t / 0.6))) * (1 - (1 - (jump_t / 0.6)))))\n\tpx = move_collide_2d_pos(__colliders_solid, px, py, 24, 28, ((move.x * 200) * dt), ((move.y * 200) * dt), (float_nearly_zero(a=jump_t, tol=0.0001) ? 0 : ((192 * (1 - (jump_t / 0.6))) * (1 - (1 - (jump_t / 0.6)))))).x\n\tpy = move_collide_2d_pos(__colliders_solid, px, py, 24, 28, ((move.x * 200) * dt), ((move.y * 200) * dt), (float_nearly_zero(a=jump_t, tol=0.0001) ? 0 : ((192 * (1 - (jump_t / 0.6))) * (1 - (1 - (jump_t / 0.6)))))).y\n\tex = StepToward(ex, (get_path_step(from=make_vec2((ex + 12), (ey + 12)), to=make_vec2((px + 12), (py + 14)), diagonal=true, blocked=__colliders_block, object_id=\"stage\", avoid_tags=\"water\").found ? (get_path_step(from=make_vec2((ex + 12), (ey + 12)), to=make_vec2((px + 12), (py + 14)), diagonal=true, blocked=__colliders_block, object_id=\"stage\", avoid_tags=\"water\").x - 12) : ex), 90, dt)\n\tey = StepToward(ey, (get_path_step(from=make_vec2((ex + 12), (ey + 12)), to=make_vec2((px + 12), (py + 14)), diagonal=true, blocked=__colliders_block, object_id=\"stage\", avoid_tags=\"water\").found ? (get_path_step(from=make_vec2((ex + 12), (ey + 12)), to=make_vec2((px + 12), (py + 14)), diagonal=true, blocked=__colliders_block, object_id=\"stage\", avoid_tags=\"water\").y - 12) : ey), 90, dt)\n\nfunction StepToward(cur, target, speed, dt)\n\treturn (cur + float_clamp(value=(target - cur), min=((speed * dt) * -1), max=(speed * dt)))\n"
