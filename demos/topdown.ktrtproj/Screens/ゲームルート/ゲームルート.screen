screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables: []
requests: []
functions:
  - id: "fn_step_toward"
    name: "StepToward"
    pure: true
    access: "public"
    params:
      - name: "cur"
        type: "float"
      - name: "target"
        type: "float"
      - name: "speed"
        type: "float"
      - name: "dt"
        type: "float"
    returns:
      - name: "out"
        type: "float"
    graph:
      nodes:
        - id: "function_entry_1"
          type: "function_entry"
          next: "function_return_1"
        - id: "float_mul_1"
          type: "float_mul"
        - id: "float_sub_1"
          type: "float_sub"
        - id: "float_mul_2"
          type: "float_mul"
          properties:
            b: -1
        - id: "float_clamp_1"
          type: "float_clamp"
        - id: "float_add_1"
          type: "float_add"
        - id: "function_return_1"
          type: "function_return"
      layout:
        - id: "float_mul_1"
          x: 260
          y: 0
        - id: "float_sub_1"
          x: 260
          y: 130
        - id: "float_mul_2"
          x: 520
          y: 0
        - id: "float_clamp_1"
          x: 780
          y: 0
        - id: "float_add_1"
          x: 1040
          y: 0
        - id: "function_return_1"
          x: 1300
          y: 0
      edges:
        - from:
            nodeId: "function_entry_1"
            pin: "speed"
          to:
            nodeId: "float_mul_1"
            pin: "a"
        - from:
            nodeId: "function_entry_1"
            pin: "dt"
          to:
            nodeId: "float_mul_1"
            pin: "b"
        - from:
            nodeId: "function_entry_1"
            pin: "target"
          to:
            nodeId: "float_sub_1"
            pin: "a"
        - from:
            nodeId: "function_entry_1"
            pin: "cur"
          to:
            nodeId: "float_sub_1"
            pin: "b"
        - from:
            nodeId: "float_mul_1"
            pin: "return"
          to:
            nodeId: "float_mul_2"
            pin: "a"
        - from:
            nodeId: "float_sub_1"
            pin: "return"
          to:
            nodeId: "float_clamp_1"
            pin: "value"
        - from:
            nodeId: "float_mul_2"
            pin: "return"
          to:
            nodeId: "float_clamp_1"
            pin: "min"
        - from:
            nodeId: "float_mul_1"
            pin: "return"
          to:
            nodeId: "float_clamp_1"
            pin: "max"
        - from:
            nodeId: "function_entry_1"
            pin: "cur"
          to:
            nodeId: "float_add_1"
            pin: "a"
        - from:
            nodeId: "float_clamp_1"
            pin: "return"
          to:
            nodeId: "float_add_1"
            pin: "b"
        - from:
            nodeId: "float_add_1"
            pin: "return"
          to:
            nodeId: "function_return_1"
            pin: "out"
