screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "bg"
    name: "背景"
    type: "rectangle"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    fill: "#eef0f4"
  - id: "title"
    name: "見出し"
    type: "text"
    x: 0
    y: 260
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 80
    text: "脱出した"
    font_size: 56
    color: "#2b3a55"
    text_align: "center"
  - id: "body"
    name: "本文"
    type: "text"
    x: 0
    y: 360
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 40
    text: "外は朝だった。Space でもう一度"
    font_size: 22
    color: "#d8d3c4"
    text_align: "center"
variables: []
requests: []
script: ".events.tick.subscribe\n\tif __input_map_gameplay_act_jump_pressed\n\t\thas_key = false\n\t\tkey_on_desk = true\n\t\toni_active = false\n\t\toni_room = \"\"\n\t\toni_wait = 0\n\t\thidden = false\n\t\tface_x = 0\n\t\tface_y = 1\n\t\t.screens.scr_mansion_hall.open(transition=\"fade\", transition_duration=0.6, transition_color=\"#000000\", inputs=\"px,py\")\n"
