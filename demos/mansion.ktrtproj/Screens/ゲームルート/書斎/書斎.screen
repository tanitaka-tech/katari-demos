    tile_textures: []
    tile_colors:
      - "#4a3b2f"
      - "#241d1a"
      - "#6b2f2a"
    solid_tiles:
      - 1
  - id: "door_west"
    name: "扉 → 廊下"
    type: "rectangle"
    x: 0
    y: 320
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#1a1410"
    alpha: 0.6
    collider:
      layer: "door"
      is_trigger: true
  - id: "desk"
    name: "机"
    type: "rectangle"
    x: 640
    y: 256
    origin_x: 0
    origin_y: 0
    width: 128
    height: 64
    fill: "#7a5230"
    corner_radius: 4
    z_index: 320
    collider:
      layer: "solid"
  - id: "desk_zone"
    name: "机（調べる）"
    type: "rectangle"
    x: 630
    y: 246
    origin_x: 0
    origin_y: 0
    width: 148
    height: 84
    fill: "#ffffff"
    visible: false
    collider:
      layer: "interact"
      is_trigger: true
  - id: "bookcase"
    name: "書棚"
    type: "rectangle"
    x: 128
    y: 32
    origin_x: 0
    origin_y: 0
    width: 192
    height: 64
    fill: "#4d3a2a"
    corner_radius: 4
    z_index: 96
    collider:
      layer: "solid"
  - id: "bookcase_zone"
    name: "書棚（調べる）"
    type: "rectangle"
    x: 118
    y: 22
    origin_x: 0
    origin_y: 0
    width: 212
    height: 84
    fill: "#ffffff"
    visible: false
    collider:
      layer: "interact"
      is_trigger: true
  - id: "key"
    name: "鍵"
    type: "rectangle"
    x: 688
    y: 278
    origin_x: 0
    origin_y: 0
    width: 22
    height: 12
    fill: "#f0c541"
    corner_radius: 4
    visible: "$key_on_desk"
    z_index: 321
  - id: "player"
    name: "プレイヤー"
    type: "image"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 28
    fallback_color: "#f2d3a7"
    visible: "$player_visible"
    z_index: "=$py + 28"
  - id: "oni"
    name: "追ってくるもの"
    type: "image"
    x: "$oni_x"
    y: "$oni_y"
    origin_x: 0
    origin_y: 0
    width: 28
    height: 36
    fallback_color: "#3457d5"
    visible: "$oni_visible"
    z_index: "=$oni_y + 36"
  - id: "hint"
    name: "操作の説明"
    type: "text"
    x: 16
    y: 8
    origin_x: 0
    origin_y: 0
    width: 700
    height: 24
    text: "書斎　WASD: 歩く　Space: 調べる / 閉じる"
    font_size: 16
    color: "#cfc8b8"
    text_align: "left"
    z_index: 9000
  - id: "message_window"
    name: "メッセージ窓"
    type: "piece-instance"
    piece_id: "pc_message_window"
    x: 40
    y: 570
    origin_x: 0
    origin_y: 0
    width: 1200
    height: 118
    z_index: 10000
    visible: "$__line_open"
variables:
  - kind: "input"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "64"
  - kind: "input"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "322"
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_float_1"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Float\"]"
      next: "set_variable_1"
    - id: "on_tick_1"
      type: "on_tick"
    - id: "subscribe_float_1"
      type: "subscribe_float"
    - id: "sequence_1"
      type: "sequence"
      properties:
        then_count: 3
      next:
        then_0: "branch_1"
        then_1: "branch_9"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "oni_here"
        value: "=$oni_active && $oni_room == \"書斎\""
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "oni_visible"
        value: "=$oni_here && $oni_wait <= 0"
      next: "set_variable_3"
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "player_visible"
        value: "=!$hidden"
      next: "sequence_1"
    - id: "branch_1"
      type: "branch"
      properties:
        condition: "$__line_open"
      next:
        true: "branch_2"
        false: "branch_3"
    - id: "branch_2"
      type: "branch"
      properties:
        condition: "$__input_map_gameplay_act_jump_pressed"
      next:
        true: "advance_line_1"
    - id: "advance_line_1"
      type: "advance_line"
      properties:
        choice: 0
    - id: "branch_3"
      type: "branch"
      properties:
        condition: "$hidden"
      next:
        true: "branch_4"
        false: "set_variable_5"
    - id: "branch_4"
      type: "branch"
      properties:
        condition: "$__input_map_gameplay_act_jump_pressed"
      next:
        true: "set_variable_4"
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "hidden"
        value: false
    - id: "branch_5"
      type: "branch"
      properties:
        condition: "$__input_map_gameplay_act_jump_pressed"
      next:
        true: "set_variable_9"
    - id: "get_colliders_1"
      type: "get_colliders"
      properties:
        layer: "solid"
    - id: "get_variable_float_1"
      type: "get_variable_float"
      properties:
        variable: "px"
    - id: "get_variable_float_2"
      type: "get_variable_float"
      properties:
        variable: "py"
    - id: "float_mul_1"
      type: "float_mul"
      properties:
        a: "=$__input_map_gameplay_act_move.x"
        b: 170
    - id: "float_mul_2"
      type: "float_mul"
    - id: "float_mul_3"
      type: "float_mul"
      properties:
        a: "=$__input_map_gameplay_act_move.y"
        b: 170
    - id: "float_mul_4"
      type: "float_mul"
    - id: "move_and_collide_1"
      type: "move_and_collide"
      properties:
        width: 24
        height: 28
    - id: "break_vector2_1"
      type: "break_vector2"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "px"
      next: "set_variable_6"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
        variable: "py"
      next: "set_variable_7"
    - id: "ternary_1"
      type: "ternary"
      properties:
        index: "=$__input_map_gameplay_act_move.x != 0 || $__input_map_gameplay_act_move.y != 0"
        true: "=$__input_map_gameplay_act_move.x"
        false: "$face_x"
    - id: "set_variable_7"
      type: "set_variable"
      properties:
        variable: "face_x"
      next: "set_variable_8"
    - id: "ternary_2"
      type: "ternary"
      properties:
        index: "=$__input_map_gameplay_act_move.x != 0 || $__input_map_gameplay_act_move.y != 0"
        true: "=$__input_map_gameplay_act_move.y"
        false: "$face_y"
    - id: "set_variable_8"
      type: "set_variable"
      properties:
        variable: "face_y"
      next: "branch_5"
    - id: "get_colliders_2"
      type: "get_colliders"
      properties:
        layer: "interact"
    - id: "get_variable_float_3"
      type: "get_variable_float"
      properties:
        variable: "px"
    - id: "get_variable_float_4"
      type: "get_variable_float"
      properties:
        variable: "py"
    - id: "get_variable_float_5"
      type: "get_variable_float"
      properties:
        variable: "face_x"
    - id: "get_variable_float_6"
      type: "get_variable_float"
      properties:
        variable: "face_y"
    - id: "make_vector2_1"
      type: "make_vector2"
    - id: "probe_front_ids_1"
      type: "probe_front_ids"
      properties:
        width: 24
        height: 28
        reach: 30
        size: 16
    - id: "array_is_empty_1"
      type: "array_is_empty"
    - id: "not_op_1"
      type: "not_op"
    - id: "array_first_1"
      type: "array_first"
    - id: "ternary_3"
      type: "ternary"
      properties:
        false: ""
    - id: "set_variable_9"
      type: "set_variable"
      properties:
        variable: "probe"
      next: "branch_6"
    - id: "branch_6"
      type: "branch"
      properties:
        condition: "=$probe == \"desk_zone\""
      next:
        true: "branch_7"
        false: "branch_8"
    - id: "branch_7"
      type: "branch"
      properties:
        condition: "$key_on_desk"
      next:
        true: "set_variable_10"
        false: "show_message_2"
    - id: "set_variable_10"
      type: "set_variable"
      properties:
        variable: "key_on_desk"
        value: false
      next: "set_variable_11"
    - id: "set_variable_11"
      type: "set_variable"
      properties:
        variable: "has_key"
        value: true
      next: "set_variable_12"
    - id: "set_variable_12"
      type: "set_variable"
      properties:
        variable: "oni_active"
        value: true
      next: "set_variable_13"
    - id: "set_variable_13"
