    tile_textures: []
    tile_colors:
      - "#4a3b2f"
      - "#241d1a"
      - "#6b2f2a"
    solid_tiles:
      - 1
  - id: "door_west"
    name: "扉 → 廊下"
    type: "rectangle"
    x: 0
    y: 320
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#1a1410"
    alpha: 0.6
    collider:
      layer: "door"
      is_trigger: true
  - id: "desk"
    name: "机"
    type: "rectangle"
    x: 640
    y: 256
    origin_x: 0
    origin_y: 0
    width: 128
    height: 64
    fill: "#7a5230"
    corner_radius: 4
    z_index: 320
    collider:
      layer: "solid"
  - id: "desk_zone"
    name: "机（調べる）"
    type: "rectangle"
    x: 630
    y: 246
    origin_x: 0
    origin_y: 0
    width: 148
    height: 84
    fill: "#ffffff"
    visible: false
    collider:
      layer: "interact"
      is_trigger: true
  - id: "bookcase"
    name: "書棚"
    type: "rectangle"
    x: 128
    y: 32
    origin_x: 0
    origin_y: 0
    width: 192
    height: 64
    fill: "#4d3a2a"
    corner_radius: 4
    z_index: 96
    collider:
      layer: "solid"
  - id: "bookcase_zone"
    name: "書棚（調べる）"
    type: "rectangle"
    x: 118
    y: 22
    origin_x: 0
    origin_y: 0
    width: 212
    height: 84
    fill: "#ffffff"
    visible: false
    collider:
      layer: "interact"
      is_trigger: true
  - id: "key"
    name: "鍵"
    type: "rectangle"
    x: 688
    y: 278
    origin_x: 0
    origin_y: 0
    width: 22
    height: 12
    fill: "#f0c541"
    corner_radius: 4
    visible: "$key_on_desk"
    z_index: 321
  - id: "player"
    name: "プレイヤー"
    type: "image"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 28
    fallback_color: "#f2d3a7"
    visible: "$player_visible"
    z_index: "=$py + 28"
  - id: "oni"
    name: "追ってくるもの"
    type: "image"
    x: "$oni_x"
    y: "$oni_y"
    origin_x: 0
    origin_y: 0
    width: 28
    height: 36
    fallback_color: "#3457d5"
    visible: "$oni_visible"
    z_index: "=$oni_y + 36"
  - id: "hint"
    name: "操作の説明"
    type: "text"
    x: 16
    y: 8
    origin_x: 0
    origin_y: 0
    width: 700
    height: 24
    text: "書斎　WASD: 歩く　Space: 調べる / 閉じる"
    font_size: 16
    color: "#cfc8b8"
    text_align: "left"
    z_index: 9000
  - id: "message_window"
    name: "メッセージ窓"
    type: "piece-instance"
    piece_id: "pc_message_window"
    x: 40
    y: 570
    origin_x: 0
    origin_y: 0
    width: 1200
    height: 118
    z_index: 10000
    visible: "$__line_open"
variables:
  - kind: "input"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "64"
  - kind: "input"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "322"
requests: []
script: ".events.tick.subscribe\n\toni_here = oni_active && oni_room == \"書斎\"\n\toni_visible = oni_here && oni_wait <= 0\n\tplayer_visible = !hidden\n\tif __line_open\n\t\tif __input_map_gameplay_act_jump_pressed\n\t\t\t.message.advance(choice=0)\n\telse\n\t\tif hidden\n\t\t\tif __input_map_gameplay_act_jump_pressed\n\t\t\t\thidden = false\n\t\telse\n\t\t\tpx = move_collide_2d_pos(__colliders_solid, px, py, 24, 28, ((__input_map_gameplay_act_move.x * 170) * dt), ((__input_map_gameplay_act_move.y * 170) * dt), 0).x\n\t\t\tpy = move_collide_2d_pos(__colliders_solid, px, py, 24, 28, ((__input_map_gameplay_act_move.x * 170) * dt), ((__input_map_gameplay_act_move.y * 170) * dt), 0).y\n\t\t\tface_x = (__input_map_gameplay_act_move.x != 0 || __input_map_gameplay_act_move.y != 0 ? __input_map_gameplay_act_move.x : face_x)\n\t\t\tface_y = (__input_map_gameplay_act_move.x != 0 || __input_map_gameplay_act_move.y != 0 ? __input_map_gameplay_act_move.y : face_y)\n\t\t\tif __input_map_gameplay_act_jump_pressed\n\t\t\t\tprobe = ((!array_is_empty((overlap_ids_2d(__colliders_interact, px + 24 / 2 + vec2_x(make_vec2(face_x, face_y)) * 30 - 16 / 2, py + 28 / 2 + vec2_y(make_vec2(face_x, face_y)) * 30 - 16 / 2, 16, 16, 0)))) ? array_first((overlap_ids_2d(__colliders_interact, px + 24 / 2 + vec2_x(make_vec2(face_x, face_y)) * 30 - 16 / 2, py + 28 / 2 + vec2_y(make_vec2(face_x, face_y)) * 30 - 16 / 2, 16, 16, 0))) : \"\")\n\t\t\t\tif probe == \"desk_zone\"\n\t\t\t\t\tif key_on_desk\n\t\t\t\t\t\tkey_on_desk = false\n\t\t\t\t\t\thas_key = true\n\t\t\t\t\t\toni_active = true\n\t\t\t\t\t\toni_room = \"書斎\"\n\t\t\t\t\t\toni_x = 34\n\t\t\t\t\t\toni_y = 320\n\t\t\t\t\t\toni_wait = 0.3\n\t\t\t\t\t\toni_patience = 4\n\t\t\t\t\t\t.message.say(speaker=\"\", message=\"机の上に鍵があった。……背後で、扉の開く音がした。\")\n\t\t\t\t\telse\n\t\t\t\t\t\t.message.say(speaker=\"\", message=\"机の上には何もない。\")\n\t\t\t\telse\n\t\t\t\t\tif probe == \"bookcase_zone\"\n\t\t\t\t\t\t.message.say(speaker=\"\", message=\"びっしりと本が並んでいる。読める言葉ではない。\")\n\tif oni_here && !__line_open\n\t\tif oni_wait > 0\n\t\t\toni_wait = (oni_wait - dt)\n\t\telse\n\t\t\tif hidden\n\t\t\t\toni_patience = (oni_patience - dt)\n\t\t\t\tif oni_patience <= 0\n\t\t\t\t\toni_active = false\n\t\t\t\t\toni_room = \"\"\n\t\t\t\t\t.message.say(speaker=\"\", message=\"足音が遠ざかっていった……。\")\n\t\t\telse\n\t\t\t\toni_patience = 4\n\t\t\t\toni_x = StepToward(oni_x, (get_path_step(from=make_vec2(oni_x + 14, oni_y + 18), to=make_vec2(px + 12, py + 14), diagonal=true, blocked=__colliders_solid, object_id=\"floor\").found ? (get_path_step(from=make_vec2(oni_x + 14, oni_y + 18), to=make_vec2(px + 12, py + 14), diagonal=true, blocked=__colliders_solid, object_id=\"floor\").x - 14) : oni_x), 125, dt)\n\t\t\t\toni_y = StepToward(oni_y, (get_path_step(from=make_vec2(oni_x + 14, oni_y + 18), to=make_vec2(px + 12, py + 14), diagonal=true, blocked=__colliders_solid, object_id=\"floor\").found ? (get_path_step(from=make_vec2(oni_x + 14, oni_y + 18), to=make_vec2(px + 12, py + 14), diagonal=true, blocked=__colliders_solid, object_id=\"floor\").y - 18) : oni_y), 125, dt)\n\t\t\t\tif (vec2_distance(make_vec2(oni_x + 14, oni_y + 18), make_vec2(px + 12, py + 14)) < 22)\n\t\t\t\t\t.screens.scr_mansion_gameover.open(transition=\"fade\", transition_duration=0.4, transition_color=\"#000000\")\n\tif !__line_open && !hidden\n\t\tdoor_hit = ((!array_is_empty(overlap_ids_2d(__colliders_door, px, py, 24, 28, 0))) ? array_first(overlap_ids_2d(__colliders_door, px, py, 24, 28, 0)) : \"\")\n\t\tif door_hit == \"door_west\"\n\t\t\tif oni_here\n\t\t\t\toni_room = \"廊下\"\n\t\t\t\toni_x = 1186\n\t\t\t\toni_y = 320\n\t\t\t\toni_wait = 1.5\n\t\t\t\t.screens.scr_mansion_corridor.open(transition=\"fade\", transition_duration=0.6, transition_color=\"#000000\", inputs=\"px,py\")\n\t\t\telse\n\t\t\t\t.screens.scr_mansion_corridor.open(transition=\"fade\", transition_duration=0.6, transition_color=\"#000000\", inputs=\"px,py\")\n\nfunction StepToward(cur, target, speed, dt)\n\treturn (cur + float_clamp(value=(target - cur), min=((speed * dt) * -1), max=(speed * dt)))\n"
