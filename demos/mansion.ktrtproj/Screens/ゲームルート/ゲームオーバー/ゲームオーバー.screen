screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects:
  - id: "bg"
    name: "背景"
    type: "rectangle"
    x: 0
    y: 0
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 720
    fill: "#160b0e"
  - id: "title"
    name: "見出し"
    type: "text"
    x: 0
    y: 260
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 80
    text: "つかまった……"
    font_size: 56
    color: "#d8425f"
    text_align: "center"
  - id: "body"
    name: "本文"
    type: "text"
    x: 0
    y: 360
    origin_x: 0
    origin_y: 0
    width: 1280
    height: 40
    text: "Space でもう一度"
    font_size: 22
    color: "#d8d3c4"
    text_align: "center"
variables: []
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_float_1"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Float\"]"
      next: "branch_1"
    - id: "on_tick_1"
      type: "on_tick"
    - id: "subscribe_float_1"
      type: "subscribe_float"
    - id: "branch_1"
      type: "branch"
      properties:
        condition: "$__input_map_gameplay_act_jump_pressed"
      next:
        true: "set_variable_2"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "face_y"
        value: 1
      next: "open_screen_task_1"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "has_key"
        value: false
      next: "set_variable_3"
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "key_on_desk"
        value: true
      next: "set_variable_4"
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "oni_active"
        value: false
      next: "set_variable_5"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "oni_room"
        value: ""
      next: "set_variable_6"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
        variable: "oni_wait"
        value: 0
      next: "set_variable_7"
    - id: "set_variable_7"
      type: "set_variable"
      properties:
        variable: "hidden"
        value: false
      next: "set_variable_8"
    - id: "set_variable_8"
      type: "set_variable"
      properties:
        variable: "face_x"
        value: 0
      next: "set_variable_1"
    - id: "open_screen_task_1"
      type: "open_screen_task"
      properties:
        screen: "scr_mansion_hall"
        inputs: "px,py"
        in_px: 612
        in_py: 512
        transition: "fade"
        transition_color: "#000000"
        transition_duration: 0.6
      next: "forget_task_1"
    - id: "forget_task_1"
      type: "forget_task"
  layout:
    - id: "lambda_1"
      x: 0
      y: 130
    - id: "on_tick_1"
      x: 0
      y: 260
    - id: "subscribe_float_1"
      x: 260
      y: 0
    - id: "branch_1"
      x: 260
      y: 130
    - id: "set_variable_1"
      x: 2340
      y: 0
    - id: "set_variable_2"
      x: 520
      y: 0
    - id: "set_variable_3"
      x: 780
      y: 0
    - id: "set_variable_4"
      x: 1040
      y: 0
    - id: "set_variable_5"
      x: 1300
      y: 0
    - id: "set_variable_6"
      x: 1560
      y: 0
    - id: "set_variable_7"
      x: 1820
      y: 0
    - id: "set_variable_8"
      x: 2080
      y: 0
    - id: "open_screen_task_1"
      x: 2600
      y: 0
    - id: "forget_task_1"
      x: 2860
      y: 0
  edges:
    - from:
        nodeId: "on_tick_1"
        pin: "value"
      to:
        nodeId: "subscribe_float_1"
        pin: "source"
    - from:
        nodeId: "lambda_1"
        pin: "function"
      to:
        nodeId: "subscribe_float_1"
        pin: "on_next"
    - from:
        nodeId: "open_screen_task_1"
        pin: "task"
      to:
        nodeId: "forget_task_1"
        pin: "task"
