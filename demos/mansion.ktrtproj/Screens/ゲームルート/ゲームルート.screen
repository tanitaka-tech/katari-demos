screen_component:
  screen_space: true
  resolution_width: 1280
  resolution_height: 720
  ref_resolution_width: 1280
  ref_resolution_height: 720
  scale_mode: "blend"
  scale_blend: 0.5
  priority: 0
objects: []
variables:
  - kind: "normal"
    id: "has_key"
    name: "$has_key"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "key_on_desk"
    name: "$key_on_desk"
    value_type: "Bool"
    initial_value: "true"
  - kind: "normal"
    id: "oni_active"
    name: "$oni_active"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "oni_room"
    name: "$oni_room"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "oni_x"
    name: "$oni_x"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "oni_y"
    name: "$oni_y"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "oni_wait"
    name: "$oni_wait"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "oni_patience"
    name: "$oni_patience"
    value_type: "Float"
    initial_value: "4"
  - kind: "normal"
    id: "hidden"
    name: "$hidden"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "face_x"
    name: "$face_x"
    value_type: "Float"
    initial_value: "0"
  - kind: "normal"
    id: "face_y"
    name: "$face_y"
    value_type: "Float"
    initial_value: "1"
  - kind: "normal"
    id: "player_visible"
    name: "$player_visible"
    value_type: "Bool"
    initial_value: "true"
  - kind: "normal"
    id: "oni_here"
    name: "$oni_here"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "oni_visible"
    name: "$oni_visible"
    value_type: "Bool"
    initial_value: "false"
  - kind: "normal"
    id: "door_hit"
    name: "$door_hit"
    value_type: "String"
    initial_value: ""
  - kind: "normal"
    id: "probe"
    name: "$probe"
    value_type: "String"
    initial_value: ""
requests: []
script: "function StepToward(cur, target, speed, dt)\n\treturn (cur + float_clamp(value=(target - cur), min=((speed * dt) * -1), max=(speed * dt)))\n"
