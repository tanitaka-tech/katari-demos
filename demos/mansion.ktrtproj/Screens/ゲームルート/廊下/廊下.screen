    tile_textures: []
    tile_colors:
      - "#4a3b2f"
      - "#241d1a"
      - "#6b2f2a"
    solid_tiles:
      - 1
  - id: "door_west"
    name: "扉 → 玄関ホール"
    type: "rectangle"
    x: 0
    y: 320
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#1a1410"
    alpha: 0.6
    collider:
      layer: "door"
      is_trigger: true
  - id: "door_east"
    name: "扉 → 書斎"
    type: "rectangle"
    x: 1248
    y: 320
    origin_x: 0
    origin_y: 0
    width: 32
    height: 64
    fill: "#1a1410"
    alpha: 0.6
    collider:
      layer: "door"
      is_trigger: true
  - id: "closet"
    name: "ロッカー"
    type: "rectangle"
    x: 320
    y: 32
    origin_x: 0
    origin_y: 0
    width: 64
    height: 64
    fill: "#5a6b7a"
    corner_radius: 4
    z_index: 96
    collider:
      layer: "solid"
  - id: "closet_zone"
    name: "ロッカー（調べる）"
    type: "rectangle"
    x: 310
    y: 22
    origin_x: 0
    origin_y: 0
    width: 84
    height: 84
    fill: "#ffffff"
    visible: false
    collider:
      layer: "interact"
      is_trigger: true
  - id: "shelf"
    name: "本棚"
    type: "rectangle"
    x: 800
    y: 32
    origin_x: 0
    origin_y: 0
    width: 96
    height: 64
    fill: "#4d3a2a"
    corner_radius: 4
    z_index: 96
    collider:
      layer: "solid"
  - id: "shelf_zone"
    name: "本棚（調べる）"
    type: "rectangle"
    x: 790
    y: 22
    origin_x: 0
    origin_y: 0
    width: 116
    height: 84
    fill: "#ffffff"
    visible: false
    collider:
      layer: "interact"
      is_trigger: true
  - id: "player"
    name: "プレイヤー"
    type: "image"
    x: "$px"
    y: "$py"
    origin_x: 0
    origin_y: 0
    width: 24
    height: 28
    fallback_color: "#f2d3a7"
    visible: "$player_visible"
    z_index: "=$py + 28"
  - id: "oni"
    name: "追ってくるもの"
    type: "image"
    x: "$oni_x"
    y: "$oni_y"
    origin_x: 0
    origin_y: 0
    width: 28
    height: 36
    fallback_color: "#3457d5"
    visible: "$oni_visible"
    z_index: "=$oni_y + 36"
  - id: "hint"
    name: "操作の説明"
    type: "text"
    x: 16
    y: 8
    origin_x: 0
    origin_y: 0
    width: 700
    height: 24
    text: "廊下　WASD: 歩く　Space: 調べる / 閉じる"
    font_size: 16
    color: "#cfc8b8"
    text_align: "left"
    z_index: 9000
  - id: "msg_box"
    name: "メッセージ窓"
    type: "rectangle"
    x: 40
    y: 570
    origin_x: 0
    origin_y: 0
    width: 1200
    height: 118
    fill: "#0b0a10"
    alpha: 0.88
    corner_radius: 8
    stroke: "#d8d3c4"
    stroke_width: 2
    visible: "$msg_open"
    z_index: 10000
  - id: "msg_speaker"
    name: "話者"
    type: "text"
    x: 64
    y: 578
    origin_x: 0
    origin_y: 0
    width: 400
    height: 28
    text: "$msg_speaker"
    font_size: 20
    color: "#e8c39e"
    text_align: "left"
    visible: "$msg_open"
    z_index: 10001
  - id: "msg_text"
    name: "本文"
    type: "text"
    x: 64
    y: 610
    origin_x: 0
    origin_y: 0
    width: 1152
    height: 70
    text: "$msg"
    font_size: 24
    color: "#f4f1ea"
    text_align: "left"
    visible: "$msg_open"
    z_index: 10001
variables:
  - kind: "input"
    id: "px"
    name: "$px"
    value_type: "Float"
    initial_value: "64"
  - kind: "input"
    id: "py"
    name: "$py"
    value_type: "Float"
    initial_value: "322"
requests: []
script_graph:
  nodes:
    - id: "event_begin_play_1"
      type: "event_begin_play"
      next: "subscribe_vector2_1"
    - id: "get_input_action_vector2_1"
      type: "get_input_action_vector2"
      properties:
        actionMap: "map_gameplay"
        action: "act_move"
    - id: "lambda_1"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Vector2\"]"
      next: "set_variable_1"
    - id: "set_variable_1"
      type: "set_variable"
      properties:
        variable: "move"
    - id: "subscribe_vector2_1"
      type: "subscribe_vector2"
      next: "subscribe_bool_1"
    - id: "get_input_action_bool_1"
      type: "get_input_action_bool"
      properties:
        actionMap: "map_gameplay"
        action: "act_jump"
    - id: "lambda_2"
      type: "lambda"
      properties:
        arg_count: 1
        arg_types: "[\"Bool\"]"
      next: "set_variable_2"
    - id: "set_variable_2"
      type: "set_variable"
      properties:
        variable: "act"
    - id: "subscribe_bool_1"
      type: "subscribe_bool"
    - id: "event_tick_1"
      type: "event_tick"
      next: "set_variable_3"
    - id: "sequence_1"
      type: "sequence"
      properties:
        then_count: 3
      next:
        then_0: "branch_1"
        then_1: "branch_8"
    - id: "set_variable_3"
      type: "set_variable"
      properties:
        variable: "pressed"
        value: "=$act && !$press_prev"
      next: "set_variable_4"
    - id: "set_variable_4"
      type: "set_variable"
      properties:
        variable: "press_prev"
        value: "$act"
      next: "set_variable_5"
    - id: "set_variable_5"
      type: "set_variable"
      properties:
        variable: "msg_open"
        value: "$__line_open"
      next: "set_variable_6"
    - id: "set_variable_6"
      type: "set_variable"
      properties:
        variable: "msg"
        value: "$__line_message"
      next: "set_variable_7"
    - id: "set_variable_7"
      type: "set_variable"
      properties:
        variable: "msg_speaker"
        value: "$__line_speaker"
      next: "set_variable_8"
    - id: "set_variable_8"
      type: "set_variable"
      properties:
        variable: "oni_here"
        value: "=$oni_active && $oni_room == \"廊下\""
      next: "set_variable_9"
    - id: "set_variable_9"
      type: "set_variable"
      properties:
        variable: "oni_visible"
        value: "=$oni_here && $oni_wait <= 0"
      next: "set_variable_10"
    - id: "set_variable_10"
      type: "set_variable"
      properties:
        variable: "player_visible"
        value: "=!$hidden"
      next: "sequence_1"
    - id: "branch_1"
      type: "branch"
      properties:
        condition: "$msg_open"
      next:
        true: "branch_2"
        false: "branch_3"
    - id: "branch_2"
      type: "branch"
      properties:
        condition: "$pressed"
      next:
        true: "advance_line_1"
    - id: "advance_line_1"
      type: "advance_line"
      properties:
        choice: 0
    - id: "branch_3"
      type: "branch"
      properties:
        condition: "$hidden"
      next:
        true: "branch_4"
        false: "set_variable_12"
    - id: "branch_4"
      type: "branch"
      properties:
        condition: "$pressed"
      next:
        true: "set_variable_11"
    - id: "set_variable_11"
      type: "set_variable"
      properties:
        variable: "hidden"
        value: false
    - id: "branch_5"
      type: "branch"
      properties:
        condition: "$pressed"
      next:
        true: "set_variable_16"
    - id: "get_variable_vector2_1"
      type: "get_variable_vector2"
      properties:
        variable: "move"
    - id: "break_vector2_1"
      type: "break_vector2"
    - id: "get_colliders_1"
      type: "get_colliders"
      properties:
        layer: "solid"
    - id: "get_variable_float_1"
      type: "get_variable_float"
      properties:
        variable: "px"
    - id: "get_variable_float_2"
      type: "get_variable_float"
      properties:
        variable: "py"
    - id: "float_mul_1"
      type: "float_mul"
      properties:
        b: 170
    - id: "float_mul_2"
      type: "float_mul"
    - id: "float_mul_3"
      type: "float_mul"
      properties:
        b: 170
    - id: "float_mul_4"
      type: "float_mul"
    - id: "move_and_collide_1"
      type: "move_and_collide"
      properties:
        width: 24
        height: 28
    - id: "break_vector2_2"
      type: "break_vector2"
    - id: "get_variable_vector2_2"
      type: "get_variable_vector2"
      properties:
        variable: "move"
    - id: "vector2_length_1"
      type: "vector2_length"
    - id: "float_gt_1"
      type: "float_gt"
      properties:
        b: 0.01
    - id: "set_variable_12"
      type: "set_variable"
      properties:
        variable: "px"
      next: "set_variable_13"
    - id: "set_variable_13"
      type: "set_variable"
      properties:
        variable: "py"
      next: "set_variable_14"
    - id: "get_variable_float_3"
      type: "get_variable_float"
      properties:
        variable: "face_x"
