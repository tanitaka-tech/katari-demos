  gradientPresets: []
  filterPresets: []
look:
  postEffects: []
player:
  width: 648
  height: 1152
  fullscreen: false
  autoAdvance: false
  autoAdvanceMs: 60
  skipUnreadText: false
  fps: 60
  particleQuality: 1
  pixelSnap: false
  tickMode: "fixed"
  tickHz: 60
  gpu: "webgl2"
platform:
  permissions:
    networkAccess: false
    fileSystemAccess: false
    microphoneAccess: false
  macos:
    hardenedRuntime: true
    enableMetal: true
  windows:
    enableHighDpi: true
    requestAdmin: false
scripting:
  backend: "default"
  apiCompatibility: "v1"
  managedStripping: "none"
  strictDialogueLint: true
editor:
  maxOverflowX: 1024
  maxOverflowY: 1024
audio:
  buses: []
assets:
  image_optimize:
    enabled: false
    max_dimension: 2048
    format: "auto"
    quality: 82
    reduce_colors: false
  video_sidecar: false
  external_assets: false
  bundle_unreferenced: false
  dynamic_refs: []
  smart_folders: []
  packs: []
save:
  groups: []
localization:
  sourceLocale: "ja"
  locales: []
  tables: []
  assetVariants: {}
storePage:
  platforms: []
initialScreen: "screen_uma_ui_main"
startScene: ""
dialogueScreen: "screen_dialogue"
plugins: {}
vcs:
  lore:
    serverUrl: "lore://127.0.0.1:41337"
    autoStartLocalServer: true
network:
  allow: []
extensions: {}
vaults: []
